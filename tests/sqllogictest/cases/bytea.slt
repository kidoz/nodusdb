query TTTTTTT
SELECT 1::int4::bytea, 258::int2::bytea, '\x0102'::bytea::int4, (-1)::int8::bytea, '\x'::bytea::int4, '\xffffffff'::bytea::int4, '\x80'::bytea::int8;
----
\x00000001	\x0102	258	\xffffffffffffffff	0	-1	128

statement error
SELECT '\x010203'::bytea::int2;

query TTTTTTTT
SELECT 'abc'::bytea::text, ('\x0102'::bytea)::varchar, CAST('\x01'::bytea AS text) || 'z', to_json('\x01'::bytea), to_jsonb('\x01ff'::bytea), pg_typeof('\x01'::bytea || '\x02'), pg_typeof(sha256('a')), pg_typeof(crc32('a'));
----
\x616263	\x0102	\x01z	"\\x01"	"\\x01ff"	bytea	bytea	bigint

query TT
SELECT string_agg(x, ', '::bytea), array_agg(x ORDER BY x) FROM (VALUES ('a'::bytea), ('b')) v(x);
----
\x612c2062	{"\\x61","\\x62"}

statement ok
CREATE TABLE blobs (id int PRIMARY KEY, data bytea);

statement ok
INSERT INTO blobs VALUES (1, '\xdeadbeef'), (2, 'plain'), (3, '\x00ff'), (4, NULL);

query TTTT
SELECT id, data, length(data), encode(data, 'hex') FROM blobs ORDER BY data NULLS LAST;
----
3	\x00ff	2	00ff
2	\x706c61696e	5	706c61696e
1	\xdeadbeef	4	deadbeef
4	NULL	NULL	NULL

query T
SELECT id FROM blobs WHERE data = '\x00ff' OR data = 'plain'::bytea ORDER BY id;
----
2
3

statement ok
UPDATE blobs SET data = data || '\x01' WHERE id = 3;

query TT
SELECT data, get_byte(data, 2) FROM blobs WHERE id = 3;
----
\x00ff01	1

query TTTTTTT
SELECT pg_column_size('abc'::text), pg_column_size(1::int4), pg_column_size(1::int8), pg_column_size(1.5::numeric), pg_column_size(true), pg_column_size(repeat('x', 200)), pg_column_size('\x0102'::bytea);
----
7	4	8	10	1	204	6
