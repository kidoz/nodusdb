# bytea: input and output forms, the byte functions, hashes and checksums, encodings, and integer conversions.
query TTTTTTT
SELECT 'abc'::bytea, '\x616263'::bytea, '\x61 62'::bytea, E'\\001'::bytea, 'a\101b'::bytea, 'é'::bytea, '\x'::bytea;
----
\x616263	\x616263	\x6162	\x01	\x614162	\xc3a9	\x

statement error
SELECT '\xZZ'::bytea;

statement error
SELECT '\x6'::bytea;

statement error
SELECT 'a\9b'::bytea;

query TTTTTTT
SELECT length('\x0102'::bytea), octet_length('abc'::bytea), bit_length('ab'::bytea), 'ab'::bytea || 'cd'::bytea, 'ab'::bytea || 'c', substring('\x010203'::bytea from 2 for 1), substr('\x01020304'::bytea, 2);
----
2	3	16	\x61626364	\x616263	\x02	\x020304

query TTTTT
SELECT get_byte('\x0102'::bytea, 1), set_byte('\x0102'::bytea, 0, 255), get_bit('\x01'::bytea, 0), set_bit('\x00'::bytea, 7, 1), bit_count('\x0f01'::bytea);
----
2	\xff02	1	\x80	5

statement error
SELECT get_byte('\x01'::bytea, 5);

statement error
SELECT get_bit('\x01'::bytea, 8);

query TTTTTTT
SELECT position('\x02'::bytea in '\x010203'::bytea), btrim('\x000100'::bytea, '\x00'::bytea), ltrim('\x0001'::bytea, '\x00'::bytea), rtrim('\x0100'::bytea, '\x00'::bytea), trim('\x00'::bytea from '\x000100'::bytea), overlay('\x010203'::bytea placing '\xff'::bytea from 2 for 1), reverse('\x0102'::bytea);
----
2	\x01	\x01	\x01	\x01	\x01ff03	\x0201

query TTTTTT
SELECT '\x0a'::bytea < '\x0b'::bytea, 'ab'::bytea = 'ab', '\x01'::bytea < '\x0100'::bytea, 'abc'::bytea LIKE 'a%', max(x), min(x) FROM (VALUES ('\x01'::bytea), ('\x0a')) v(x);
----
t	t	t	t	\x0a	\x01

query TTTTTTTT
SELECT md5('abc'::bytea), md5(''), sha224(''), sha256('abc'::bytea), sha384('abc'), sha512(''), crc32('abc'::bytea), crc32c('abc'::bytea);
