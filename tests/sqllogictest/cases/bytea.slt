query TTTTTTTTT
SELECT encode('abc'::bytea, 'hex'), encode('abc'::bytea, 'base64'), encode(E'a\\000b'::bytea, 'escape'), encode('\x00ff5c27'::bytea, 'escape'), decode('616263', 'hex'), decode('YWJj', 'base64'), decode('a\000b', 'escape'), decode(' YW Jj ', 'base64'), decode('+/8=', 'base64');
----
