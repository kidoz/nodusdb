# Maintenance DDL the parser has no grammar for. `COMMENT ON INDEX` stores
# a comment on the index, which `pg_description` and `obj_description`
# report as a comment on the index's `pg_class` entry. `COMMENT ON
# FUNCTION` (and `PROCEDURE`, `ROUTINE`, `AGGREGATE`) resolves the
# signature against PostgreSQL's built-in functions — an unknown name, a
# signature no overload takes, and an ambiguous bare name are PostgreSQL's
# errors — but keeps no comment: there are no user-defined functions to
# comment, and the built-ins keep PostgreSQL's own. `REINDEX` resolves
# (and so validates) its target, `CREATE STATISTICS` the table and its
# columns, and `DROP`/`ALTER STATISTICS` are their tag alone. Errors,
# results, and command tags are PostgreSQL 18.4's.
#
# Known divergences: the built-in catalog indexes PostgreSQL has (a
# `REINDEX INDEX pg_class_oid_index` finds one there) have no names here;
# a statistics object is not kept, so `CREATE STATISTICS` never reports a
# duplicate name and a `DROP`/`ALTER` of a missing one does not fail; a
# comment on a function is not stored; `CREATE STATISTICS` checks plain
# column targets only (an expression target's columns are left
# unresolved), keeps the statistics kinds unvalidated, and does not refuse
# `CREATE STATISTICS` where PostgreSQL takes an `on` name; `REINDEX
# (VERBOSE)` reports nothing; a `REINDEX` that would rebuild something
# rebuilds nothing; PostgreSQL wraps a multi-statement simple query in an
# implicit transaction block, so a statement of one that fails takes the
# batch's earlier statements with it (and `REINDEX SCHEMA`/`DATABASE`/
# `SYSTEM` and `REINDEX CONCURRENTLY` are refused in a batch), where
# NodusDB commits each statement of a batch on its own.

statement ok
drop table if exists t1 cascade;

statement ok
create table t1 (k int primary key, v int);

statement ok
create unique index t1_v on t1 (v);

statement ok
comment on index t1_v is 'the v index';

query T
select obj_description((select oid from pg_class where relname = 't1_v'), 'pg_class');
----
the v index

query T
select description from pg_description
where objoid = (select oid from pg_class where relname = 't1_v');
----
the v index

statement ok
comment on index t1_v is 'better';

query T
select obj_description((select oid from pg_class where relname = 't1_v'), 'pg_class');
----
better

statement ok
comment on index t1_pkey is 'the key';

query I
select count(*) from pg_description
where description = 'the key'
  and objoid = (select oid from pg_class where relname = 't1_pkey');
----
1

statement ok
comment on index t1_v is null;

query T
select obj_description((select oid from pg_class where relname = 't1_v'), 'pg_class');
----
NULL

