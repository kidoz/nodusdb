# Hash joins on computed keys: an equality whose side is an expression
# (`e1.a + 1 = e2.a`, `(e1.a)::text = e2.b`) hashes the value each side
# computes, for inner, outer, and semi/anti joins and for `ANY`/`IN`
# alike. Results and plans are from PostgreSQL 18.4; where PostgreSQL
# hashes the other side, the join is the mirror of its plan.

statement ok
drop table if exists e1 cascade;

statement ok
drop table if exists e2 cascade;

statement ok
create table e1 (a int, b text);

statement ok
create table e2 (a int, b text);

statement ok
insert into e1 values (1, 'x1'), (2, 'x2'), (3, 'x3'), (null, 'xn'), (4, 'x4');

statement ok
insert into e2 values (2, 'y2'), (3, 'y3'), (3, 'y3b'), (null, 'yn'), (5, 'y5');

statement ok
analyze e1;

statement ok
analyze e2;

# A computed side hashes its value.
query T
explain (costs off) select * from e1 join e2 on e1.a + 1 = e2.a;
----
Hash Join
  Hash Cond: ((e1.a + 1) = e2.a)
  ->  Seq Scan on e1
  ->  Hash
        ->  Seq Scan on e2


query T
explain (costs off) select * from e1 join e2 on (e1.a)::text = e2.b;
----
Hash Join
  Hash Cond: ((e1.a)::text = e2.b)
  ->  Seq Scan on e1
  ->  Hash
        ->  Seq Scan on e2


# Both sides may compute.
query T
explain (costs off) select * from e1 join e2 on e1.a * 2 = e2.a * 2;
----
Hash Join
  Hash Cond: ((e1.a * 2) = (e2.a * 2))
  ->  Seq Scan on e1
  ->  Hash
        ->  Seq Scan on e2


# A condition over both sides is the join filter, checked per pair.
query T
explain (costs off) select * from e1 join e2 on e1.a + 1 = e2.a and e1.b <> e2.b;
----
Hash Join
  Hash Cond: ((e1.a + 1) = e2.a)
  Join Filter: (e1.b <> e2.b)
  ->  Seq Scan on e1
  ->  Hash
        ->  Seq Scan on e2


# An existential correlated by an expression hashes too.
query T
explain (costs off) select * from e1 where exists (select 1 from e2 where e2.a = e1.a + 1);
----
Hash Semi Join
  Hash Cond: ((e1.a + 1) = e2.a)
  ->  Seq Scan on e1
  ->  Hash
        ->  Seq Scan on e2


query T
explain (costs off) select * from e1 where not exists (select 1 from e2 where e2.a = e1.a + 1);
----
Hash Anti Join
  Hash Cond: ((e1.a + 1) = e2.a)
  ->  Seq Scan on e1
  ->  Hash
        ->  Seq Scan on e2


query T
explain (costs off) select * from e1 where e1.a + 1 in (select a from e2);
----
Hash Semi Join
  Hash Cond: ((e1.a + 1) = e2.a)
  ->  Seq Scan on e1
  ->  Hash
        ->  Seq Scan on e2


# The rows agree with the plain comparison.
query T
select e1.a, e2.a from e1 join e2 on e1.a + 1 = e2.a order by 1, 2;
----
1	2
2	3
2	3
4	5


query T
select e1.a, e2.a from e1 left join e2 on e1.a + 1 = e2.a order by 1, 2;
----
1	2
2	3
2	3
3	NULL
4	5
NULL	NULL


query T
select e1.a, e2.a from e1 full join e2 on e1.a + 1 = e2.a order by 1, 2;
----
1	2
2	3
2	3
3	NULL
4	5
NULL	NULL
NULL	NULL


query T
select count(*) from e1, e2 where e1.a + 1 = e2.a;
----
4


query T
select e1.a, e2.b from e1 join e2 on (e1.a)::text = e2.b order by 1;
----


query T
select e1.a from e1 where exists (select 1 from e2 where e2.a = e1.a + 1) order by 1;
----
1
2
4


query T
select e1.a from e1 where not exists (select 1 from e2 where e2.a = e1.a + 1) order by 1;
----
3
NULL


query T
select count(*) from e1 where e1.a + 1 in (select a from e2);
----
3


query T
update e1 set b = 'w' where exists (select 1 from e2 where e2.a = e1.a + 1);
----


query T
select a, b from e1 order by 1;
----
1	w
2	w
3	x3
4	w
NULL	xn


