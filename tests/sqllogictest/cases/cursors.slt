BEGIN;

statement ok
DECLARE a CURSOR FOR SELECT 1;

statement ok
DECLARE b SCROLL CURSOR WITH HOLD FOR SELECT 2;

query TTTT
SELECT name, statement, is_holdable, is_scrollable FROM pg_cursors ORDER BY name;
----
a	DECLARE a CURSOR FOR SELECT 1;	f	f
b	DECLARE b SCROLL CURSOR WITH HOLD FOR SELECT 2;	t	t

statement ok
CLOSE ALL;

query T
