# DDL forms: CREATE TABLE LIKE, identity and serial columns added later, ALTER INDEX RENAME, and maintenance statements.
statement ok
CREATE TABLE a14 (id int GENERATED ALWAYS AS IDENTITY PRIMARY KEY, name text NOT NULL DEFAULT 'anon', score numeric(5,2), n int);

statement ok
INSERT INTO a14 (name, score) VALUES ('x', 1.5), ('y', 2);

statement ok
CREATE TABLE b14 (LIKE a14);

query TTTT
SELECT column_name, data_type, column_default, is_nullable FROM information_schema.columns WHERE table_name = 'b14' ORDER BY ordinal_position;
----
id	integer	NULL	NO
name	text	NULL	NO
score	numeric	NULL	YES
n	integer	NULL	YES

statement ok
CREATE TABLE c14 (LIKE a14 INCLUDING DEFAULTS);

query TT
SELECT column_name, column_default FROM information_schema.columns WHERE table_name = 'c14' ORDER BY ordinal_position;
----
id	NULL
name	'anon'::text
score	NULL
n	NULL

query TTTT
INSERT INTO c14 (id) VALUES (5) RETURNING *;
----
5	anon	NULL	NULL

statement ok
ALTER TABLE a14 ADD COLUMN seq_col int GENERATED BY DEFAULT AS IDENTITY;

statement ok
ALTER TABLE a14 ADD COLUMN ser bigserial;

query TTT
SELECT id, seq_col, ser FROM a14 ORDER BY id;
----
1	1	1
2	2	2

query TTT
INSERT INTO a14 (name) VALUES ('after') RETURNING id, seq_col, ser;
----
3	3	3

query TTT
SELECT column_name, is_identity, identity_generation FROM information_schema.columns WHERE table_name = 'a14' AND column_name IN ('id', 'seq_col') ORDER BY 1;
----
id	YES	ALWAYS
seq_col	YES	BY DEFAULT

statement ok
CREATE INDEX a14_name ON a14 (name);

statement ok
ALTER INDEX a14_name RENAME TO a14_name_idx;

query T
SELECT indexname FROM pg_indexes WHERE tablename = 'a14' ORDER BY 1;
----
a14_name_idx
a14_pkey

statement error
ALTER INDEX nope14 RENAME TO nope15;

statement error
ALTER INDEX a14_name_idx RENAME TO a14;

statement ok
CHECKPOINT;

statement ok
VACUUM ANALYZE a14;

statement ok
VACUUM (ANALYZE) a14;

statement ok
REINDEX TABLE a14;

statement ok
ANALYZE a14;
