# Explicit NULLS FIRST / NULLS LAST overrides on ORDER BY. As in PostgreSQL, the
# default sorts NULL as larger than any value: last on ASC and first on DESC; an
# explicit clause overrides that.

statement ok
CREATE TABLE n (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO n VALUES (1, 10), (2, NULL), (3, 30), (4, NULL), (5, 20);

# Default ASC: nulls last.
query I
SELECT v FROM n ORDER BY v ASC;
----
10
20
30
NULL
NULL

# ASC NULLS LAST: override pushes nulls to the end.
query I
SELECT v FROM n ORDER BY v ASC NULLS LAST;
----
10
20
30
NULL
NULL

# Default DESC: nulls first.
query I
SELECT v FROM n ORDER BY v DESC;
----
NULL
NULL
30
20
10

# DESC NULLS FIRST: override pulls nulls to the front.
query I
SELECT v FROM n ORDER BY v DESC NULLS FIRST;
----
NULL
NULL
30
20
10

# NULLS override also works on an aggregate result column.
query II
SELECT v, count(*) FROM n GROUP BY v ORDER BY v ASC NULLS LAST;
----
10	1
20	1
30	1
NULL	2

# ORDER BY ... USING <operator> parses but has no executor support; it must be
# rejected rather than silently sorted ascending, in both query and window
# ORDER BY clauses.
statement error
SELECT v FROM n ORDER BY v USING >;

statement error
SELECT id, row_number() OVER (ORDER BY v USING >) FROM n;
