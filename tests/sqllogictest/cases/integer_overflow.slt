# Integer arithmetic is computed in its operands' type: overflowing integer
# or smallint is an error rather than a wider result. Expected results come
# from PostgreSQL 18.
statement ok
CREATE TABLE ov (id INT PRIMARY KEY, i INT, s SMALLINT, b BIGINT);

statement ok
INSERT INTO ov VALUES (1, 2147483647, 32767, 9223372036854775807), (2, 5, 5, 5);

statement error
SELECT i + 1 FROM ov WHERE id = 1;

statement error
SELECT i * 2 FROM ov WHERE id = 1;

statement error
SELECT -i - 2 FROM ov WHERE id = 1;

statement error
SELECT s + s FROM ov WHERE id = 1;

query TTT
SELECT s + 1, i + 1::bigint, i::bigint * 2 FROM ov WHERE id = 1;
----
32768	2147483648	4294967294

statement error
SELECT b + 1 FROM ov WHERE id = 1;

statement error
SELECT 2147483647 + 1;

statement error
SELECT (2147483647 + 1) / 2;

query TT
SELECT 2147483648 + 1, 2147483647::bigint + 1;
----
2147483649	2147483648

statement error
SELECT 32767::smallint + 1::smallint;

statement error
SELECT (-2147483648)::int / -1;

statement error
SELECT id FROM ov WHERE i + 1 > 0;

statement error
UPDATE ov SET i = i + 1 WHERE id = 1;

statement error
INSERT INTO ov (id, s) VALUES (3, 32767::smallint + 1::smallint);

statement error
VALUES (2147483647 + 1);

query TT
SELECT sum(i), sum(i + 0) FROM ov;
----
2147483652	2147483652

query TTTTT
SELECT pg_typeof(s), pg_typeof(s + s), pg_typeof(s + 1), pg_typeof(i + b), pg_typeof(-s) FROM ov WHERE id = 2;
----
smallint	smallint	integer	bigint	smallint

query TTTTT
SELECT pg_typeof(1), pg_typeof('a'), pg_typeof(1.5), pg_typeof(NULL), pg_typeof(2147483648);
----
integer	unknown	numeric	unknown	bigint

query TT
SELECT id, i + 1 FROM ov WHERE id = 2;
----
2	6
