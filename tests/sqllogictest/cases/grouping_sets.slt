# ROLLUP, CUBE, and GROUPING SETS over columns and expressions, and GROUPING().
statement ok
CREATE TABLE sales (id int PRIMARY KEY, region text, product text, qty int, price numeric(8,2), sold date);

statement ok
INSERT INTO sales VALUES (1,'east','apple',10,1.50,'2024-01-01'),(2,'east','pear',5,2.00,'2024-01-02'),(3,'west','apple',7,1.50,'2024-01-02'),(4,'west','pear',3,2.00,'2024-01-05'),(5,'west','apple',7,1.60,'2024-01-09'),(6,'north','plum',1,3.00,'2024-01-10'),(7,'east','apple',2,1.55,'2024-01-10');

query TTTTTT
SELECT region, product, sum(qty), GROUPING(region), GROUPING(product), GROUPING(region, product) FROM sales GROUP BY ROLLUP (region, product) ORDER BY region NULLS LAST, product NULLS LAST;
----
east	apple	12	0	0	0
east	pear	5	0	0	0
east	NULL	17	0	1	1
north	plum	1	0	0	0
north	NULL	1	0	1	1
west	apple	14	0	0	0
west	pear	3	0	0	0
west	NULL	17	0	1	1
NULL	NULL	35	1	1	3

query TTT
SELECT region, product, sum(qty) FROM sales GROUP BY CUBE (region, product) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
east	apple	12
east	pear	5
east	NULL	17
north	plum	1
north	NULL	1
west	apple	14
west	pear	3
west	NULL	17
NULL	apple	26
NULL	pear	8
NULL	plum	1
NULL	NULL	35

query TTT
SELECT region, product, count(*) FROM sales GROUP BY GROUPING SETS ((region), (product), ()) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
east	NULL	3
north	NULL	1
west	NULL	3
NULL	apple	4
NULL	pear	2
NULL	plum	1
NULL	NULL	7

query TT
SELECT CASE WHEN GROUPING(region) = 1 THEN 'total' ELSE region END AS r, sum(qty) FROM sales GROUP BY ROLLUP (region) ORDER BY 1;
----
east	17
north	1
total	35
west	17

query TT
SELECT region, sum(qty) FROM sales GROUP BY region HAVING GROUPING(region) = 0 ORDER BY 1;
----
east	17
north	1
west	17

query TTT
SELECT date_trunc('month', sold)::date AS m, region, sum(qty) FROM sales GROUP BY ROLLUP (1, 2) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
2024-01-01	east	17
2024-01-01	north	1
2024-01-01	west	17
2024-01-01	NULL	35
NULL	NULL	35

query TTT
SELECT region, product, sum(qty) FROM sales GROUP BY region, ROLLUP (product) ORDER BY 1, 2 NULLS LAST;
----
east	apple	12
east	pear	5
east	NULL	17
north	plum	1
north	NULL	1
west	apple	14
west	pear	3
west	NULL	17

query TTT
SELECT region, count(*), sum(count(*)) OVER () FROM sales GROUP BY ROLLUP (region) ORDER BY 1 NULLS LAST;
----
east	3	14
north	1	14
west	3	14
NULL	7	14

query TT
SELECT coalesce(region, 'ALL'), sum(qty) FROM sales GROUP BY CUBE (region) ORDER BY 1;
----
ALL	35
east	17
north	1
west	17

query TTTT
SELECT region, product, grouping(region, product), sum(qty) FROM sales GROUP BY GROUPING SETS ((region, product), (region), ()) HAVING sum(qty) > 3 ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
east	apple	0	12
east	pear	0	5
east	NULL	1	17
west	apple	0	14
west	NULL	1	17
NULL	NULL	3	35

statement error
SELECT region, GROUPING(product) FROM sales GROUP BY region;
