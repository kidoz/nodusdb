<xsd:schema@    xmlns:xsd="http://www.w3.org/2001/XMLSchema"@    targetNamespace="urn:t"@    elementFormDefault="qualified">@@<xsd:simpleType name="NUMERIC">@</xsd:simpleType>@@<xsd:simpleType name="BOOLEAN">@  <xsd:restriction base="xsd:boolean"></xsd:restriction>@</xsd:simpleType>@@<xsd:simpleType name="UDT.default.pg_catalog.bytea">@  <xsd:restriction base="xsd:base64Binary">@  </xsd:restriction>@</xsd:simpleType>@@<xsd:simpleType name="UDT.default.pg_catalog.uuid">@</xsd:simpleType>@@<xsd:complexType name="RowType.default.s2.t2">@  <xsd:sequence>@    <xsd:element name="x" type="NUMERIC" nillable="true"></xsd:element>@    <xsd:element name="y" type="BOOLEAN" nillable="true"></xsd:element>@    <xsd:element name="z" type="UDT.default.pg_catalog.bytea" nillable="true"></xsd:element>@    <xsd:element name="w" type="UDT.default.pg_catalog.uuid" nillable="true"></xsd:element>@  </xsd:sequence>@</xsd:complexType>@@<xsd:complexType name="TableType.default.s2.t2">@  <xsd:sequence>@    <xsd:element name="row" type="RowType.default.s2.t2" minOccurs="0" maxOccurs="unbounded"/>@  </xsd:sequence>@</xsd:complexType>@@<xsd:element name="t2" type="TableType.default.s2.t2"/>@@</xsd:schema>

