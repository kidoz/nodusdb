# The SQL-to-XML mapping functions (table_to_xml, query_to_xml,
# schema_to_xml, database_to_xml, and their schema forms), PG 18.4. The
# documents' newlines show as `@` so each value is one line.
statement ok
create table t1(a int, b text, c date);

statement ok
insert into t1 values (1, 'x', '2020-01-02'), (2, null, null);

statement ok
create schema s2;

statement ok
create table s2.t2(x numeric, y bool, z bytea, w uuid);

statement ok
insert into s2.t2 values (1.5, true, '\xab', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11');

statement ok
create view v1 as select a, b from t1;

query T
select replace((table_to_xml('t1', true, false, ''))::text, chr(10), '@');;
----
<t1 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">@@<row>@  <a>1</a>@  <b>x</b>@  <c>2020-01-02</c>@</row>@@<row>@  <a>2</a>@  <b xsi:nil="true"/>@  <c xsi:nil="true"/>@</row>@@</t1>@

