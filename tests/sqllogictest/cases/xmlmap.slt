query T
select replace((table_to_xmlschema('t1', true, false, ''))::text, chr(10), '@');;
----
<xsd:schema@    xmlns:xsd="http://www.w3.org/2001/XMLSchema">@@<xsd:simpleType name="INTEGER">@  <xsd:restriction base="xsd:int">@    <xsd:maxInclusive value="2147483647"/>@    <xsd:minInclusive value="-2147483648"/>@  </xsd:restriction>@</xsd:simpleType>@@<xsd:simpleType name="UDT.default.pg_catalog.text">@  <xsd:restriction base="xsd:string">@  </xsd:restriction>@</xsd:simpleType>@@<xsd:simpleType name="DATE">@  <xsd:restriction base="xsd:date">@    <xsd:pattern value="\p{Nd}{4}-\p{Nd}{2}-\p{Nd}{2}"/>@  </xsd:restriction>@</xsd:simpleType>@@<xsd:complexType name="RowType.default.public.t1">@  <xsd:sequence>@    <xsd:element name="a" type="INTEGER" nillable="true"></xsd:element>@    <xsd:element name="b" type="UDT.default.pg_catalog.text" nillable="true"></xsd:element>@    <xsd:element name="c" type="DATE" nillable="true"></xsd:element>@  </xsd:sequence>@</xsd:complexType>@@<xsd:complexType name="TableType.default.public.t1">@  <xsd:sequence>@    <xsd:element name="row" type="RowType.default.public.t1" minOccurs="0" maxOccurs="unbounded"/>@  </xsd:sequence>@</xsd:complexType>@@<xsd:element name="t1" type="TableType.default.public.t1"/>@@</xsd:schema>

