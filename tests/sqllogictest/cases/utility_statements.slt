# TRUNCATE, maintenance commands, array subscripts, set-returning functions
# in a select list, and statements NodusDB does not support. Expected results
# come from PostgreSQL 18.
statement ok
CREATE TABLE tr1 (id SERIAL PRIMARY KEY, v TEXT);

statement ok
CREATE TABLE tr2 (k INT UNIQUE);

statement ok
INSERT INTO tr1 (v) VALUES ('a'), ('b');

statement ok
INSERT INTO tr2 VALUES (1), (2);

statement ok
TRUNCATE tr1;

query T
SELECT count(*) FROM tr1;
----
0

statement ok
INSERT INTO tr1 (v) VALUES ('c');

query TT
SELECT id, v FROM tr1;
----
3	c

statement ok
TRUNCATE TABLE tr1, tr2 RESTART IDENTITY;

statement ok
INSERT INTO tr1 (v) VALUES ('d');

statement ok
INSERT INTO tr2 VALUES (1);

query TT
SELECT id, v FROM tr1;
----
1	d

query T
SELECT k FROM tr2;
----
1

statement error
TRUNCATE nosuch;

statement ok
ANALYZE tr1;

statement ok
ANALYZE;

statement ok
VACUUM;

statement ok
VACUUM tr1;

query TTTTT
SELECT (ARRAY[1,2,3])[2], (ARRAY[1,2,3])[5], (ARRAY[1,2,3])[2:3], (ARRAY[1,2,3])[:2], (ARRAY[[1,2],[3,4]])[2][1];
----
2	NULL	{2,3}	{1,2}	3

statement ok
CREATE TABLE arr1 (id INT, xs INT[]);

statement ok
INSERT INTO arr1 VALUES (1, '{10,20,30}'), (2, '{5}');

query TTT
SELECT id, xs[1], xs[2] FROM arr1 ORDER BY id;
----
1	10	20
2	5	NULL

query T
SELECT id FROM arr1 WHERE xs[2] = 20;
----
1

query T
SELECT generate_series(1, 3);
----
1
2
3

query T
SELECT generate_series(1, 5, 2) AS n;
----
1
3
5

query T
SELECT unnest(ARRAY['a', 'b']);
----
a
b

query T
SELECT jsonb_array_elements_text('["x", "y"]');
----
x
y

# Arguments of set-returning functions may be expressions.
query T
SELECT * FROM generate_series(1, 2 + 1);
----
1
2
3

query TT
SELECT id, x FROM arr1, generate_series(1, id * 2) x ORDER BY 1, 2;
----
1	1
1	2
2	1
2	2
2	3
2	4

query T
SELECT * FROM unnest(ARRAY[1, 2] || 3) u;
----
1
2
3

query T
SELECT generate_series(1, 1 + 1);
----
1
2

statement error
CREATE FUNCTION f(a int) RETURNS int AS 'select a' LANGUAGE sql;

statement error
CREATE EXTENSION pgcrypto;

statement error
CREATE TYPE mood AS ENUM ('a');
