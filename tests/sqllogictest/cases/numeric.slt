# Exact numeric arithmetic, numeric(p,s) storage, and integer ranges.
# Expected results come from PostgreSQL 18.
query TTTTT
SELECT 0.1 + 0.2, 1.10 * 3, 10.0 / 4, 1 / 3::numeric, 2.5::numeric(10,2);
----
0.3	3.30	2.5000000000000000	0.33333333333333333333	2.50

query TTTTTTTT
SELECT 7 / 2, 7 % 3, -7 / 2, 7.0 / 2, 1e3, 1.5e-3, 123.4500, -0.50;
----
3	1	-3	3.5000000000000000	1000	0.0015	123.4500	-0.50

query TTTTT
SELECT 10::numeric / 3, 1::numeric(5,2) / 3, 2147483647::numeric / 1, 1.0 / 7, 100 / 0.25;
----
3.3333333333333333	0.33333333333333333333	2147483647.00000000	0.14285714285714285714	400.0000000000000000

query TTTTT
SELECT 12.35 / 1, 0.001 / 3, 5.5 % 2, -5.5 % 2, 1.10 - 0.1;
----
12.3500000000000000	0.00033333333333333333	1.5	-1.5	1.00

query TTTTT
SELECT 1.10 = 1.1, 1.10 < 1.2, 2 = 2.0, 0.1::float8 + 0.2::float8, 1.5 + 1::float8;
----
t	t	t	0.30000000000000004	2.5

query TTTTTTTT
SELECT round(2.567, 2), round(2.5), round(3.5), round(-2.5), round(2.5, 3), round(1234.5, -2), trunc(2.567, 1), trunc(-2.567);
----
2.57	3	4	-3	2.500	1200	2.5	-2

query TTTTTTT
SELECT ceil(1.2), floor(-1.2), abs(-1.50), sign(-3.2), sign(0.0), round(2.5::float8), round(3.5::float8);
----
2	-2	1.50	-1	0	2	4

query TTTTTTT
SELECT 1.5::int, 2.5::int, (-1.5)::int, '1.50'::numeric, '1.50'::numeric(4,1), 1.0::float8, 2.25::numeric(5,1);
----
2	3	-2	1.50	1.5	1	2.3

query TTTTT
SELECT pg_typeof(1.5), pg_typeof(1), pg_typeof(1.5::float8), pg_typeof(10 / 4.0), pg_typeof(1 + 1.5);
----
numeric	integer	double precision	numeric	numeric

statement ok
CREATE TABLE nm (id INT PRIMARY KEY, i INT, s SMALLINT, b BIGINT, n NUMERIC(10,2), d NUMERIC, f FLOAT8);

statement ok
INSERT INTO nm VALUES (1, 2147483647, 32767, 9223372036854775807, 12.345, 1.10, 0.1), (2, -5, 0, 0, 0.005, 3, 1.5), (3, 7, 1, 1, 7, 7.0, 7);

query TTTTTTT
SELECT * FROM nm ORDER BY id;
----
1	2147483647	32767	9223372036854775807	12.35	1.10	0.1
2	-5	0	0	0.01	3	1.5
3	7	1	1	7.00	7.0	7

query TTTTT
SELECT n * 2, n / 3, n + 0.001, d * d, f * 3 FROM nm ORDER BY id;
----
24.70	4.1166666666666667	12.351	1.2100	0.30000000000000004
0.02	0.00333333333333333333	0.011	9	4.5
14.00	2.3333333333333333	7.001	49.00	21

query TTTTTTTTTT
SELECT sum(i), avg(i), sum(n), avg(n), sum(d), avg(d), sum(f), avg(f), min(n), max(d) FROM nm;
----
2147483649	715827883.00000000	19.36	6.4533333333333333	11.10	3.7000000000000000	8.6	2.8666666666666667	0.01	7.0

query T
SELECT id FROM nm WHERE n = 12.35 OR d = 7 ORDER BY id;
----
1
3

query T
SELECT id FROM nm WHERE d > 1.1 AND d < 3.5 ORDER BY id;
----
2

query TT
SELECT d, count(*) FROM (SELECT d FROM nm UNION ALL SELECT 1.1 UNION ALL SELECT 7.00) x GROUP BY d ORDER BY d;
----
1.10	2
3	1
7.0	2

query T
SELECT DISTINCT d FROM (SELECT 1.1 AS d UNION ALL SELECT 1.10 UNION ALL SELECT 1.100) x;
----
1.1

query T
SELECT 1.1 UNION SELECT 1.10;
----
1.1

query T
SELECT n FROM nm ORDER BY n DESC;
----
12.35
7.00
0.01

statement ok
UPDATE nm SET n = n * 2 WHERE id = 1;

query T
SELECT n FROM nm WHERE id = 1;
----
24.70

statement ok
CREATE INDEX nm_d_idx ON nm (d);

query T
SELECT id FROM nm WHERE d = 7 ORDER BY id;
----
3

query T
SELECT id FROM nm WHERE d = 1.100 ORDER BY id;
----
1

query TTTTT
SELECT count(*), sum(1), avg(2), min(1.5), max(2.50) FROM nm;
----
3	3	2.0000000000000000	1.5	2.50

query TT
SELECT 9223372036854775807::numeric + 1, sum(b) FROM nm;
----
9223372036854775808	9223372036854775808

# Values outside a column's range or precision are rejected.
statement error
INSERT INTO nm (id, i) VALUES (10, 2147483648);

statement error
INSERT INTO nm (id, s) VALUES (11, 32768);

statement error
INSERT INTO nm (id, n) VALUES (12, 123456789.123);

statement error
UPDATE nm SET s = s + 1 WHERE id = 1;

statement error
SELECT 3000000000::int;

statement error
SELECT 70000::smallint;

statement error
SELECT 9223372036854775807 + 1;

statement error
SELECT 1 / 0.0;

statement error
SELECT 5.5 % 0;

statement error
SELECT 'abc'::numeric;

statement error
SELECT 123.456::numeric(4,2);

statement ok
DROP TABLE nm;
