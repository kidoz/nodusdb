# Hash joins and the `Materialize` node: an equality join hashes one
# side, a join with no equality is a nested loop over a materialized
# inner input. Results and plans are from PostgreSQL 18.4, except for
# the side a hash is built from: PostgreSQL picks one by cost from its
# statistics and may hash either relation, while NodusDB — having none —
# always builds the hash from the right one. Where PostgreSQL mirrors
# the join, the `Hash Cond` sides and the children below are the mirror
# of its plan, and a mirrored outer join is printed `Hash Right Join`.

statement ok
drop table if exists hj1 cascade;

statement ok
drop table if exists hj2 cascade;

statement ok
create table hj1 (a int, b text);

statement ok
create table hj2 (a int, c text);

statement ok
insert into hj1 values (1, 'x1'), (2, 'x2'), (3, 'x3'), (null, 'xnull'), (4, 'x4');

statement ok
insert into hj2 values (2, 'y2'), (3, 'y3'), (3, 'y3b'), (null, 'ynull'), (5, 'y5');

statement ok
analyze hj1;

statement ok
analyze hj2;

# An equality join hashes the right side.
query T
explain (costs off) select * from hj1 join hj2 on hj1.a = hj2.a;
----
Hash Join
  Hash Cond: (hj1.a = hj2.a)
  ->  Seq Scan on hj1
  ->  Hash
        ->  Seq Scan on hj2


# The outer joins keep their sides.
query T
explain (costs off) select * from hj1 left join hj2 on hj1.a = hj2.a;
----
Hash Left Join
  Hash Cond: (hj1.a = hj2.a)
  ->  Seq Scan on hj1
  ->  Hash
        ->  Seq Scan on hj2


query T
explain (costs off) select * from hj1 right join hj2 on hj1.a = hj2.a;
----
Hash Left Join
  Hash Cond: (hj2.a = hj1.a)
  ->  Seq Scan on hj2
  ->  Hash
        ->  Seq Scan on hj1


query T
explain (costs off) select * from hj1 full join hj2 on hj1.a = hj2.a;
----
Hash Full Join
  Hash Cond: (hj1.a = hj2.a)
  ->  Seq Scan on hj1
  ->  Hash
        ->  Seq Scan on hj2


# A condition over one side alone is pushed onto its scan.
query T
explain (costs off) select * from hj1 join hj2 on hj1.a = hj2.a and hj2.c <> 'y2';
----
Hash Join
  Hash Cond: (hj1.a = hj2.a)
  ->  Seq Scan on hj1
  ->  Hash
        ->  Seq Scan on hj2
              Filter: (c <> 'y2'::text)


# A condition over both sides is the join filter, checked on each pair.
query T
explain (costs off) select * from hj1 join hj2 on hj1.a = hj2.a and hj1.b <> hj2.c;
----
Hash Join
  Hash Cond: (hj1.a = hj2.a)
  Join Filter: (hj1.b <> hj2.c)
  ->  Seq Scan on hj1
  ->  Hash
        ->  Seq Scan on hj2


# With no equality to hash, the join is a nested loop over a
# materialized inner input.
query T
explain (costs off) select * from hj1 join hj2 on hj1.a < hj2.a;
----
Nested Loop
  Join Filter: (hj1.a < hj2.a)
  ->  Seq Scan on hj1
  ->  Materialize
        ->  Seq Scan on hj2


# `Material` off drops the materialize; a nested loop chosen while
# disabled says so.
statement ok
set enable_material = off;

query T
explain (costs off) select * from hj1 join hj2 on hj1.a < hj2.a;
----
Nested Loop
  Join Filter: (hj1.a < hj2.a)
  ->  Seq Scan on hj1
  ->  Seq Scan on hj2


statement ok
reset enable_material;

statement ok
set enable_nestloop = off;

query T
explain (costs off) select * from hj1 join hj2 on hj1.a < hj2.a;
----
Nested Loop
  Disabled: true
  Join Filter: (hj1.a < hj2.a)
  ->  Seq Scan on hj1
  ->  Materialize
        ->  Seq Scan on hj2


statement ok
reset enable_nestloop;

# With hash joins off PostgreSQL plans a merge join; NodusDB has no
# merge join and falls back to a nested loop.
statement ok
set enable_hashjoin = off;

query T
explain (costs off) select * from hj1 join hj2 on hj1.a = hj2.a;
----
Nested Loop
  Join Filter: (hj1.a = hj2.a)
  ->  Seq Scan on hj1
  ->  Materialize
        ->  Seq Scan on hj2


statement ok
reset enable_hashjoin;

# A comma join with equality in `WHERE` joins the same way.
query T
explain (costs off) select * from hj1, hj2 where hj1.a = hj2.a;
----
Hash Join
  Hash Cond: (hj1.a = hj2.a)
  ->  Seq Scan on hj1
  ->  Hash
        ->  Seq Scan on hj2


# NULL keys match nothing, and a duplicate on the right multiplies.
query T
select hj1.a, hj1.b, hj2.a, hj2.c from hj1 join hj2 on hj1.a = hj2.a order by 1, 4;
----
2	x2	2	y2
3	x3	3	y3
3	x3	3	y3b


query T
select hj1.a, hj1.b, hj2.a, hj2.c from hj1 left join hj2 on hj1.a = hj2.a order by 1, 4;
----
1	x1	NULL	NULL
2	x2	2	y2
3	x3	3	y3
3	x3	3	y3b
4	x4	NULL	NULL
NULL	xnull	NULL	NULL


query T
select hj1.a, hj1.b, hj2.a, hj2.c from hj1 right join hj2 on hj1.a = hj2.a order by 1, 3, 4;
----
2	x2	2	y2
3	x3	3	y3
3	x3	3	y3b
NULL	NULL	5	y5
NULL	NULL	NULL	ynull


query T
select hj1.a, hj1.b, hj2.a, hj2.c from hj1 full join hj2 on hj1.a = hj2.a order by 1, 2, 4;
----
1	x1	NULL	NULL
2	x2	2	y2
3	x3	3	y3
3	x3	3	y3b
4	x4	NULL	NULL
NULL	xnull	NULL	NULL
NULL	NULL	5	y5
NULL	NULL	NULL	ynull


# A join filter admits the pairs it holds for.
query T
select hj1.a, hj1.b, hj2.c from hj1 join hj2 on hj1.a = hj2.a and hj1.b <> hj2.c order by 1;
----
2	x2	y2
3	x3	y3
3	x3	y3b


query T
select count(*) from hj1 join hj2 on hj1.a < hj2.a;
----
9


# `USING` and `NATURAL` name the columns both sides share.
query T
select hj1.b, hj2.c from hj1 join hj2 using (a) order by 1;
----
x2	y2
x3	y3
x3	y3b


query T
select hj1.b, hj2.c from hj1 natural join hj2 order by 1;
----
x2	y2
x3	y3
x3	y3b


