query TTTTTTT
SELECT typname, typtype, typcategory, typlen, typbyval, typalign, typstorage FROM pg_type WHERE typname IN ('inet','cidr','macaddr','macaddr8','money') ORDER BY typname;
----
cidr	b	I	-1	f	i	m
inet	b	I	-1	f	i	m
macaddr	b	U	6	f	i	p
macaddr8	b	U	8	f	i	p
money	b	N	8	t	d	p

query TTTTT
SELECT format_type(869, NULL), format_type(650, NULL), format_type(829, NULL), format_type(774, NULL), format_type(790, NULL);
----
inet	cidr	macaddr	macaddr8	money

query TTT
