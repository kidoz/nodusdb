CREATE TABLE nn (id int PRIMARY KEY, ip inet, c cidr, m macaddr, m8 macaddr8, v money);

statement ok
INSERT INTO nn VALUES (1, '192.168.1.5/24', '192.168.1.0/24', '08:00:2b:01:02:03', '08:00:2b:01:02:03:04:05', '1234.56');

statement ok
INSERT INTO nn VALUES (2, '10.0.0.1', '10.0.0.0/8', '09:00:2b:01:02:03', '08:00:2b:01:02:03:04:06', '-5.00');

statement ok
INSERT INTO nn VALUES (3, NULL, NULL, NULL, NULL, NULL);

