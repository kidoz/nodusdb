SELECT rngtypid, rngsubtype, rngcollation, rngsubopc, rngcanonical, rngsubdiff FROM pg_range WHERE rngtypid = 3904;
----
3904	23	0	1978	int4range_canonical	int4range_subdiff

query TTTTTT
SELECT format_type(3904, NULL), format_type(3906, NULL), format_type(3912, NULL), format_type(3926, NULL), format_type(3908, NULL), format_type(3910, NULL);
