query T
SELECT ARRAY['[1,2)'::int4range, '[3,4)'::int4range];
----
{"[1,2)","[3,4)"}

query T
SELECT '{}'::int4range[];
----
{}

query T
SELECT unnest(ARRAY['[1,2)'::int4range]);
----
