# Range types: literals and canonicalization, constructors, accessors,
# operators, storage, casts, and catalogs. Expected results come from
# PostgreSQL 18.
query T
SELECT 'empty'::int4range;
----
empty

query T
SELECT '[1,5)'::int4range;
----
[1,5)

query T
SELECT '[1,5]'::int4range;
----
[1,6)

query T
SELECT '(1,5)'::int4range;
----
[2,5)

query T
SELECT '(1,5]'::int4range;
----
[2,6)

query T
SELECT '[,5)'::int4range;
----
(,5)

query T
SELECT '(,)'::int4range;
----
(,)

statement error
SELECT 'x'::int4range;

statement error
SELECT '(1,5'::int4range;

statement error
SELECT '[1,x)'::int4range;

query T
SELECT int4range(1, 5);
----
[1,5)

query T
SELECT int4range(1, 5, '[]');
----
[1,6)

query T
SELECT int4range(NULL, 5);
----
(,5)

query T
SELECT int4range(1, NULL);
----
[1,)

statement error
SELECT int4range(5, 1);

statement error
SELECT int4range(1, 5, 'x');

query T
SELECT int4range(1, 1);
----
empty

query T
SELECT int4range(int4range(1, 5));
----
[1,5)

query T
SELECT int8range(1, 5, '(]');
----
[2,6)

query T
SELECT numrange(1.5, 2.5);
----
[1.5,2.5)

query T
SELECT numrange(1.5, 2.5, '(]');
----
(1.5,2.5]

query T
SELECT numrange(NULL, 2.5, '()');
----
(,2.5)

query T
SELECT numrange(NULL, NULL);
----
(,)

query T
SELECT daterange('2020-01-01', '2020-01-03');
----
[2020-01-01,2020-01-03)

query T
SELECT daterange('2020-01-01', '2020-01-03', '[]');
----
[2020-01-01,2020-01-04)

query T
SELECT daterange('2020-01-01', '2020-01-03', '()');
----
[2020-01-02,2020-01-03)

query T
SELECT daterange('2020-01-01', '2020-01-01');
----
empty

statement error
SELECT daterange('2020-01-03', '2020-01-01');

query T
SELECT tsrange('2020-01-01 00:00', '2020-01-02 00:00');
----
["2020-01-01 00:00:00","2020-01-02 00:00:00")

query T
SELECT tstzrange('2020-01-01 00:00+00', '2020-01-02 00:00+00');
----
["2020-01-01 00:00:00+00","2020-01-02 00:00:00+00")

query T
SELECT tstzrange('2020-01-01 00:00+00', '2020-01-02 00:00+00', '[]');
----
["2020-01-01 00:00:00+00","2020-01-02 00:00:00+00"]

query TT
SELECT upper('[1,5]'::int4range), upper_inc('[1,5]'::int4range);
----
6	f

query TT
SELECT lower('[1,5)'::int4range), upper('[1,5)'::int4range);
----
1	5

query TT
SELECT lower_inc('[1,5)'::int4range), upper_inc('[1,5)'::int4range);
----
t	f

query TT
SELECT lower_inf('(,5)'::int4range), upper_inf('(,5)'::int4range);
----
t	f

query TTTT
SELECT lower('empty'::int4range), upper('empty'::int4range), lower_inc('empty'::int4range), upper_inc('empty'::int4range);
----
NULL	NULL	f	f

query TT
SELECT lower_inf('empty'::int4range), upper_inf('empty'::int4range);
----
f	f

query TT
SELECT isempty('empty'::int4range), isempty('[1,2)'::int4range);
----
t	f

query TT
SELECT lower(numrange(1.5, 2.5)), upper(numrange(1.5, 2.5));
----
1.5	2.5

query T
SELECT lower(tsrange('2020-01-01 00:00', '2020-01-02 00:00'));
----
2020-01-01 00:00:00

query T
SELECT lower(daterange('2020-01-01', '2020-01-03'));
----
2020-01-01

query TT
SELECT '[1,5]'::int4range = '[1,6)'::int4range, '(1,5)'::int4range = '[2,5)'::int4range;
----
t	t

query TT
SELECT 'empty'::int4range = 'empty'::int4range, 'empty'::int4range < '[1,2)'::int4range;
----
t	t

query TT
SELECT '[1,5)'::int4range < '[2,5)'::int4range, '[2,3)'::int4range > '[1,3)'::int4range;
----
t	t

query TT
SELECT '[1,3)'::int4range <> '[2,3)'::int4range, '[1,3)'::int4range <= '[1,3)'::int4range;
----
t	t

query TT
SELECT '[1,5)'::int4range && '[4,8)'::int4range, '[1,5)'::int4range && '[5,8)'::int4range;
----
t	f

query TT
SELECT '[1,5)'::int4range && 'empty'::int4range, '[1,5)'::int4range @> NULL;
----
f	NULL

query TTT
SELECT '[1,5)'::int4range @> 3, '[1,5)'::int4range @> 5, '[1,5]'::int4range @> 5;
----
t	f	t

query TT
SELECT '[1,5)'::int4range @> '[2,3)'::int4range, '[1,5)'::int4range <@ '[1,5)'::int4range;
----
t	t

query T
SELECT 3 <@ '[1,5)'::int4range;
----
t

query TT
SELECT '[1,5)'::int4range << '[6,8)'::int4range, '[1,5)'::int4range << '[5,8)'::int4range;
----
t	t

query T
SELECT '[1,5)'::int4range -|- '[5,8)'::int4range;
----
t

statement error
SELECT '[1,5)'::int4range && '[1,5]'::numrange;

query TT
SELECT '[1,5)'::int4range &< '[2,3)'::int4range, '[1,5)'::int4range &< '[5,8)'::int4range;
----
f	t

query TT
SELECT '[1,5)'::int4range &> '[4,9)'::int4range, '[1,5)'::int4range >> '[5,8)'::int4range;
----
f	f

