query T rowsort
SELECT r FROM (VALUES ('[1,2)'::int4range), ('empty'::int4range), ('[3,4)'::int4range)) t(r) ORDER BY r;
----
empty
[1,2)
[3,4)

query T
SELECT r FROM (VALUES ('[1,2)'::int4range)) t(r) ORDER BY r;
----
[1,2)

statement ok
CREATE TABLE rt (id int PRIMARY KEY, r int4range, d daterange);

statement ok
INSERT INTO rt VALUES (1, '[1,5)', '[2020-01-01,2020-01-02)');

statement ok
INSERT INTO rt VALUES (2, 'empty', NULL);

statement ok
INSERT INTO rt VALUES (3, '(1,5]', '[2020-01-01,2020-01-03]');

query TTT
SELECT * FROM rt ORDER BY id;
----
1	[1,5)	[2020-01-01,2020-01-02)
2	empty	NULL
3	[2,6)	[2020-01-01,2020-01-04)

query T
SELECT r FROM rt WHERE r @> 3 ORDER BY r;
----
[1,5)
[2,6)

query T
SELECT r FROM rt WHERE r && '[0,2)'::int4range ORDER BY r;
----
[1,5)

query T
SELECT r FROM rt ORDER BY r;
----
empty
[1,5)
[2,6)

statement error
SELECT min(r) FROM rt;

statement error
SELECT sum(r) FROM rt;

query TT
SELECT count(r), array_agg(r) FROM rt;
----
3	{"[1,5)",empty,"[2,6)"}

statement ok
CREATE TABLE ck (r int4range CHECK (r @> 0));

statement ok
INSERT INTO ck VALUES ('[-1,1)');

statement error
INSERT INTO ck VALUES ('[5,6)');

query T
SELECT r FROM ck;
----
[-1,1)

query T
SELECT count(*) FROM rt GROUP BY r ORDER BY 1;
----
1
1
1

query T
SELECT DISTINCT r FROM rt ORDER BY r;
----
empty
[1,5)
[2,6)

