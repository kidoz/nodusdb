# jsonb values print in PostgreSQL's normalized form: keys unique and ordered
# shorter first, then bytewise, with ", " and ": " separators. Expected results
# come from PostgreSQL 18.
query T
SELECT '{"b": 1, "a": [1, 2, {"z": null, "y": true}], "aa": "x"}'::jsonb;
----
{"a": [1, 2, {"y": true, "z": null}], "b": 1, "aa": "x"}

query TTTTT
SELECT '{"a": 1, "a": 2}'::jsonb, '{}'::jsonb, '[]'::jsonb, 'null'::jsonb, '"s"'::jsonb;
----
{"a": 2}	{}	[]	null	"s"

query T
SELECT '[1e20, 1.5e-7, 2]'::jsonb;
----
[100000000000000000000, 0.00000015, 2]

query TT
SELECT '{"b":1,"a":2}'::json, '  { "x" : 1 }  '::json;
----
{"b":1,"a":2}	  { "x" : 1 }  

query T
SELECT '"é\t"'::jsonb;
----
"é\t"

query TT
SELECT jsonb_build_object('k', 1, 'b', 'x', 'long', NULL), to_jsonb(ARRAY[1,2,3]);
----
{"b": "x", "k": 1, "long": null}	[1, 2, 3]

query TT
SELECT json_build_object('k', 1, 'b', 'x'), json_build_array(1, 'x', NULL, true);
----
{"k" : 1, "b" : "x"}	[1, "x", null, true]

query T
SELECT jsonb_agg(x ORDER BY x) FROM (VALUES (2), (1)) t(x);
----
[1, 2]

query T
SELECT json_agg(x ORDER BY x) FROM (VALUES ('b'), ('a')) t(x);
----
["a", "b"]

query T
SELECT jsonb_object_agg(k, v ORDER BY k) FROM (VALUES ('bb', 1), ('a', 2)) t(k, v);
----
{"a": 2, "bb": 1}

query TTT
SELECT '{"a": {"b": [1, 2]}}'::jsonb -> 'a', '{"a": {"b": [1, 2]}}'::jsonb #> '{a,b}', '[1, 2, 3]'::jsonb -> -1;
----
{"b": [1, 2]}	[1, 2]	3

query TTTT
SELECT '{"a":1}'::jsonb || '{"b":2}'::jsonb, '[1]'::jsonb || '[2, 3]'::jsonb, '{"a":1}'::jsonb || '[2]'::jsonb, '[1]'::jsonb || '2'::jsonb;
----
{"a": 1, "b": 2}	[1, 2, 3]	[{"a": 1}, 2]	[1, 2]

query TTTT
SELECT '{"a":1, "b":2}'::jsonb - 'a', '[1,2,3]'::jsonb - 1, '[1,2,3]'::jsonb - -1, '["a","b"]'::jsonb - 'a';
----
{"b": 2}	[1, 3]	[1, 2]	["b"]

query TT
SELECT jsonb_set('{"a": 1}', '{b}', '"x"'), jsonb_strip_nulls('{"b": null, "a": [1, null]}');
----
{"a": 1, "b": "x"}	{"a": [1, null]}

query T
SELECT replace(jsonb_pretty('{"a": [1, {"b": 2}], "c": {}}'), chr(10), '/');
----
{/    "a": [/        1,/        {/            "b": 2/        }/    ],/    "c": {/    }/}

query TTTT
SELECT replace(jsonb_pretty('[]'), chr(10), '/'), jsonb_pretty('1'), jsonb_typeof('1'), jsonb_typeof('"x"');
----
[/]	1	number	string

query TTT
SELECT '{"a":1}'::jsonb = '{ "a" : 1 }'::jsonb, '{"a":1.0}'::jsonb = '{"a":1}'::jsonb, '{"a":1}'::jsonb @> '{}';
----
t	t	t

statement error
SELECT '{bad'::jsonb;

statement error
SELECT 'not json'::json;

# Documents in jsonb columns are stored parsed; json columns keep their text.
statement ok
CREATE TABLE jdocs (id INT PRIMARY KEY, d JSONB, j JSON);

statement ok
INSERT INTO jdocs VALUES (1, '{"z": 1, "a": {"y": 2, "b": 3}}', '{"z": 1,  "a": 2}'), (2, '[3, 1]', '[]');

statement error
INSERT INTO jdocs VALUES (3, 'not json', '{}');

statement error
INSERT INTO jdocs VALUES (3, '{}', 'bad');

query TTTT
SELECT id, d, j, d::text FROM jdocs ORDER BY id;
----
1	{"a": {"b": 3, "y": 2}, "z": 1}	{"z": 1,  "a": 2}	{"a": {"b": 3, "y": 2}, "z": 1}
2	[3, 1]	[]	[3, 1]

query T
UPDATE jdocs SET d = d || '{"new": true}' WHERE id = 1 RETURNING d;
----
{"a": {"b": 3, "y": 2}, "z": 1, "new": true}

query T
UPDATE jdocs SET d = d - 'z' WHERE id = 1 RETURNING d;
----
{"a": {"b": 3, "y": 2}, "new": true}

query TTTT
SELECT id, d -> 'a', d ->> 'new', d #>> '{a,b}' FROM jdocs ORDER BY id;
----
1	{"b": 3, "y": 2}	true	3
2	NULL	NULL	NULL

query T
SELECT x FROM jsonb_array_elements_text('["x", 1, null]') x;
----
x
1
NULL

query T
SELECT id FROM jdocs WHERE d = '{"new": true, "a": {"b": 3, "y": 2}}';
----
1

query T
SELECT id FROM jdocs WHERE d @> '{"a": {"b": 3}}';
----
1

query T
SELECT jsonb_build_object('doc', d) FROM jdocs WHERE id = 1;
----
{"doc": {"a": {"b": 3, "y": 2}, "new": true}}

query T
SELECT d FROM jdocs ORDER BY d;
----
[3, 1]
{"a": {"b": 3, "y": 2}, "new": true}

query T
SELECT count(DISTINCT d) FROM jdocs;
----
2
