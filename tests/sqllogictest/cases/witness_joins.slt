# Witness joins: an `[NOT] EXISTS` / `IN` whose inner is unique on the join
# keys — a primary key or unique index covering the columns the equality
# reads — matches at most one row, so PostgreSQL plans it as a plain inner
# join, marked `"Inner Unique": true`, instead of a semi join. A non-unique
# inner keeps the semi join (`Hash Semi Join`), `NOT EXISTS` keeps its anti
# join, and a composite unique index witnesses only when every one of its
# columns takes part. Plans and results from PostgreSQL 18.4; JSON parity is
# covered by the parsed-tree sweep (multi-line JSON values do not fit a
# sqllogictest record).
#
# Known divergences: a non-unique inner that PostgreSQL makes unique by
# deduplicating it (`HashAggregate` under the `Hash`) keeps its semi join
# here; the nested-loop form (`Nested Loop` with `Inner Unique`, when hash
# joins are disabled) keeps its `Nested Loop Semi Join` label.

statement ok
drop table if exists w1 cascade;

statement ok
create table w1 (k int primary key, v int);

statement ok
insert into w1 select i, i * 7 % 41 from generate_series(1, 40) i;

statement ok
analyze w1;

statement ok
drop table if exists w2 cascade;

statement ok
create table w2 (a int, b int, c int, primary key (a, b));

statement ok
insert into w2 select i % 5, i, i from generate_series(1, 20) i;

statement ok
analyze w2;

statement ok
set enable_mergejoin = off;

statement ok
set enable_nestloop = off;

query T
explain (costs off) select * from w1 g where exists (select 1 from w1 x where x.k = g.v);
----
Hash Join
  Hash Cond: (g.v = x.k)
  ->  Seq Scan on w1 g
  ->  Hash
        ->  Seq Scan on w1 x

query T
explain (costs off) select * from w1 g where g.v in (select x.k from w1 x);
----
Hash Join
  Hash Cond: (g.v = x.k)
  ->  Seq Scan on w1 g
  ->  Hash
        ->  Seq Scan on w1 x

query T
explain (costs off) select * from w1 g where exists (select 1 from w1 x where x.k = g.v and x.v > 20);
----
Hash Join
  Hash Cond: (g.v = x.k)
  ->  Seq Scan on w1 g
  ->  Hash
        ->  Seq Scan on w1 x
              Filter: (v > 20)

query T
explain (costs off) select * from w1 g where not exists (select 1 from w1 x where x.k = g.v);
----
Hash Anti Join
  Hash Cond: (g.v = x.k)
  ->  Seq Scan on w1 g
  ->  Hash
        ->  Seq Scan on w1 x

query T
explain (costs off) select * from w1 g where exists (select 1 from w1 x where x.v = g.v);
----
Hash Semi Join
  Hash Cond: (g.v = x.v)
  ->  Seq Scan on w1 g
  ->  Hash
        ->  Seq Scan on w1 x

query T
explain (costs off) select * from w2 g where exists (select 1 from w2 x where x.a = g.c and x.b = g.a);
----
Hash Join
  Hash Cond: ((g.c = x.a) AND (g.a = x.b))
  ->  Seq Scan on w2 g
  ->  Hash
        ->  Seq Scan on w2 x

query T
explain (costs off) delete from w1 g where exists (select 1 from w1 x where x.k = g.v);
----
Delete on w1 g
  ->  Hash Join
        Hash Cond: (g.v = x.k)
        ->  Seq Scan on w1 g
        ->  Hash
              ->  Seq Scan on w1 x

query T
explain (costs off) update w1 g set v = 0 where exists (select 1 from w1 x where x.k = g.v);
----
Update on w1 g
  ->  Hash Join
        Hash Cond: (g.v = x.k)
        ->  Seq Scan on w1 g
        ->  Hash
              ->  Seq Scan on w1 x

