query TT
select * from ts_parse('default', 'a fat cat 42');
----
1	a
12	 
1	fat
12	 
1	cat
12	 
22	42

query TT
select * from ts_parse('pg_catalog.default', 'e-mail x@y.z');
----
16	e-mail
11	e
12	-
11	mail
12	 
1	x
12	@
19	y.z

query TT
select * from ts_parse(3722, 'a b');
----
1	a
12	 
1	b

query TT
select tokid, token from ts_parse('default', 'The fat cats');
----
1	The
12	 
1	fat
12	 
1	cats

statement error
select * from ts_parse('nope', 'x');

statement error
select * from ts_parse('a b', 'x');

statement error
select * from ts_parse(999, 'x');

query TTT
select * from ts_token_type('default') where tokid between 10 and 16;
----
10	hword_part	Hyphenated word part, all letters
11	hword_asciipart	Hyphenated word part, all ASCII
12	blank	Space symbols
13	tag	XML tag
14	protocol	Protocol head
15	numhword	Hyphenated word, letters and digits
16	asciihword	Hyphenated word, all ASCII

query TTT
select * from ts_token_type('pg_catalog.default') limit 3;
----
1	asciiword	Word, all ASCII
2	word	Word, all letters
3	numword	Word, letters and digits

query TTT
select * from ts_token_type(3722) where tokid > 20;
----
21	int	Signed integer
22	uint	Unsigned integer
23	entity	XML entity

statement error
select * from ts_token_type('nope');

