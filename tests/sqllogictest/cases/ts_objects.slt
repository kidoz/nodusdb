query TTTT
select pg_ts_config_is_visible(999999) is null, pg_ts_dict_is_visible(999999) is null, pg_ts_parser_is_visible(999999) is null, pg_ts_template_is_visible(999999) is null;
----
t	t	t	t

query TT
select obj_description(3748, 'pg_ts_config'), obj_description(13282, 'pg_ts_config');
----
simple configuration	configuration for english language

query TT
select obj_description(3765, 'pg_ts_dict'), obj_description(13281, 'pg_ts_dict');
----
simple dictionary: just lower case and check for stopword	snowball stemmer for english language

query TTT
select obj_description(3722, 'pg_ts_parser'), obj_description(3727, 'pg_ts_template'), obj_description(13268, 'pg_ts_template');
