----
protocol	Protocol head	http://	{}	NULL	NULL
url	URL	example.com/path	{simple}	simple	{example.com/path}
host	Host	example.com	{simple}	simple	{example.com}
url_path	URL path	/path	{simple}	simple	{/path}

query TTT
select alias, token, lexemes from ts_debug('english', 'e-mail: x@y.z');
----
asciihword	e-mail	{e-mail}
hword_asciipart	e	{e}
blank	-	NULL
hword_asciipart	mail	{mail}
blank	: 	NULL
asciiword	x	{x}
blank	@	NULL
file	y.z	{y.z}

query T
select ts_lexize('simple', 'Cats');
----
{cats}

query T
select ts_lexize('english_stem', 'cats');
----
{cat}

query T
select ts_lexize('english_stem', 'the');
----
{}

query T
select ts_lexize('english_stem', '');
----
{}

query T
select ts_lexize('simple', '');
----
{}

query T
select ts_lexize('simple', 'The A the');
----
{"the a the"}

query T
select ts_lexize('english_stem', '123');
----
{123}

query T
select ts_lexize('english_stem', 'fat-cat');
----
{fat-cat}

statement error
select ts_lexize('nope', 'x');

statement error
select ts_lexize('a b', 'x');

query T
select ts_lexize('simple', NULL);
----
NULL

query T
select ts_lexize(NULL, 'x');
----
NULL

query T
select ts_lexize('simple'::regdictionary, 'Cats');
----
{cats}

query T
select 'english_stem'::regdictionary;
----
english_stem

query T
select 'simple'::regdictionary;
----
simple

statement error
select 'nope'::regdictionary;

statement error
select 'a b'::regdictionary;

query T
select 'pg_catalog.english_stem'::regdictionary;
----
english_stem

query T
select get_current_ts_config();
----
english

query T
select pg_typeof(get_current_ts_config());
----
regconfig

query T
select 'english'::regconfig = get_current_ts_config();
----
t

query T
select ts_rewrite('a & b'::tsquery, 'a'::tsquery, 'c'::tsquery);
----
'b' & 'c'

query T
select ts_rewrite('a & b'::tsquery, 'x'::tsquery, 'c'::tsquery);
----
'b' & 'a'

query T
select ts_rewrite('a | b'::tsquery, 'a'::tsquery, 'c'::tsquery);
----
'b' | 'c'

query T
select ts_rewrite('a & b'::tsquery, 'a & b'::tsquery, 'c'::tsquery);
----
'c'

query T
select ts_rewrite('a'::tsquery, 'a'::tsquery, 'b | c'::tsquery);
----
'b' | 'c'

query T
select ts_rewrite('a & b & c'::tsquery, 'b'::tsquery, 'x & y'::tsquery);
----
'x' & 'y' & 'c' & 'a'

query T
select ts_rewrite('a | (b & c)'::tsquery, 'b'::tsquery, 'x'::tsquery);
----
'a' | 'x' & 'c'

query T
select ts_rewrite('!a & b'::tsquery, 'b'::tsquery, 'c'::tsquery);
----
'c' & !'a'

query T
select ts_rewrite('a:* & b'::tsquery, 'a:*'::tsquery, 'c'::tsquery);
----
'b' & 'c'

query T
select ts_rewrite('a <-> b'::tsquery, 'a'::tsquery, 'c'::tsquery);
----
'c' <-> 'b'

query T
select ts_rewrite('a'::tsquery, 'b'::tsquery, 'c'::tsquery);
----
'a'

query T
select ts_rewrite('a <2> b'::tsquery, 'a <-> b'::tsquery, 'x'::tsquery);
----
'a' <2> 'b'

query T
select ts_rewrite('a & a'::tsquery, 'a'::tsquery, 'b'::tsquery);
----
'b' & 'b'

query T
select ts_rewrite('a & (a | c)'::tsquery, 'a'::tsquery, 'b'::tsquery);
----
'b' & ( 'c' | 'b' )

query T
select ts_rewrite('((a & b) & c)'::tsquery, 'a & b'::tsquery, 'x'::tsquery);
----
'c' & 'x'

query T
select ts_rewrite('a'::tsquery, 'a'::tsquery, 'a & b'::tsquery);
----
'a' & 'b'

query T
select ts_rewrite(NULL, 'a'::tsquery, 'b'::tsquery);
----
NULL

query T
select ts_rewrite('a'::tsquery, NULL::tsquery, 'b'::tsquery);
----
NULL

query TTTTT
select oid, cfgname, cfgnamespace, cfgowner, cfgparser from pg_ts_config where cfgname in ('simple', 'english') order by oid;
----
3748	simple	11	10	3722
13282	english	11	10	3722

query TTTTTT
select oid, dictname, dictnamespace, dictowner, dicttemplate, dictinitoption from pg_ts_dict where dictname in ('simple', 'english_stem') order by oid;
----
3765	simple	11	10	3727	NULL
13281	english_stem	11	10	13268	language = 'english', stopwords = 'english'

query TTTTTTTT
select oid, prsname, prsnamespace, prsstart, prstoken, prsend, prsheadline, prslextype from pg_ts_parser;
----
3722	default	11	prsd_start	prsd_nexttoken	prsd_end	prsd_headline	prsd_lextype

query TTTTT
select oid, tmplname, tmplnamespace, tmplinit, tmpllexize from pg_ts_template where tmplname in ('simple', 'snowball') order by oid;
----
3727	simple	11	dsimple_init	dsimple_lexize
13268	snowball	11	dsnowball_init	dsnowball_lexize

