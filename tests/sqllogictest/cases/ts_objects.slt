blank	Space symbols	 	{}	NULL	NULL
uint	Unsigned integer	42	{simple}	simple	{42}
blank	Space symbols	 	{}	NULL	NULL
asciiword	Word, all ASCII	rats	{english_stem}	english_stem	{rat}

