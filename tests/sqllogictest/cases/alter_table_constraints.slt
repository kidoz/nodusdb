statement ok
ALTER TABLE at9c VALIDATE CONSTRAINT at9c_p_fkey;

statement ok
ALTER TABLE at9p DROP CONSTRAINT at9p_pkey CASCADE;

query TT
SELECT attname, attnotnull FROM pg_attribute WHERE attrelid = 'at9p'::regclass AND attnum > 0 ORDER BY attnum;
----
id	t
code	f
n	f

