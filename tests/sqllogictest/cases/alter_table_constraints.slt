# A primary key added to a table with rows; several operations at once.
statement ok
CREATE TABLE at9k (a int, b text, c int CHECK (c > 0));

statement ok
INSERT INTO at9k VALUES (1, 'x', 1), (2, 'y', 2), (2, 'z', 3);

statement error
ALTER TABLE at9k ADD PRIMARY KEY (a);

statement ok
ALTER TABLE at9k ADD PRIMARY KEY (a, b);

query TTT
SELECT * FROM at9k WHERE a = 2 AND b = 'z';
----
2	z	3

statement error
INSERT INTO at9k VALUES (2, 'z', 4);

statement ok
UPDATE at9k SET c = 10 WHERE a = 2 AND b = 'y';

query TTT
SELECT * FROM at9k ORDER BY a, b;
----
1	x	1
2	y	10
2	z	3

statement ok
ALTER TABLE at9k ADD COLUMN d int DEFAULT 7 NOT NULL, ADD COLUMN e text UNIQUE, ALTER COLUMN b SET DEFAULT 'q';

query TTTTT
INSERT INTO at9k (a, c) VALUES (3, 1) RETURNING *;
----
3	q	1	7	NULL

statement ok
ALTER TABLE at9k ALTER COLUMN b DROP DEFAULT;

statement error
ALTER TABLE at9k ALTER COLUMN e SET NOT NULL;

statement ok
ALTER TABLE at9k RENAME COLUMN c TO cc;

statement error
INSERT INTO at9k (a, b, cc) VALUES (9, 'w', -1);

query TT
SELECT conname, pg_get_constraintdef(oid) FROM pg_constraint WHERE conrelid = 'at9k'::regclass ORDER BY 1;
----
at9k_a_not_null	NOT NULL a
at9k_b_not_null	NOT NULL b
at9k_c_check	CHECK ((cc > 0))
at9k_d_not_null	NOT NULL d
at9k_e_key	UNIQUE (e)
at9k_pkey	PRIMARY KEY (a, b)

