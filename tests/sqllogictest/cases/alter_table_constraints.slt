# ALTER TABLE adds and drops columns and constraints, changes defaults and
# NOT NULL, and renames, checking the rows the table has.
statement ok
CREATE TABLE at9p (id int PRIMARY KEY, code text, n int);

statement ok
CREATE TABLE at9c (id int, p int REFERENCES at9p);

statement ok
INSERT INTO at9p VALUES (1, 'a', NULL), (2, 'a', 5);

statement ok
INSERT INTO at9c VALUES (1, 1);

statement error
ALTER TABLE at9p ADD COLUMN code text;

statement ok
ALTER TABLE at9p ADD COLUMN IF NOT EXISTS code text;

statement error
ALTER TABLE at9p ADD COLUMN z int NOT NULL;

statement error
ALTER TABLE at9p DROP COLUMN nosuch;

statement ok
ALTER TABLE at9p DROP COLUMN IF EXISTS nosuch;

statement error
ALTER TABLE at9p ALTER COLUMN n SET NOT NULL;

statement error
ALTER TABLE at9p ALTER COLUMN id DROP NOT NULL;

statement error
ALTER TABLE at9p ADD CONSTRAINT at9p_n_check CHECK (n > 10);

statement error
ALTER TABLE at9p ADD CONSTRAINT at9p_code_key UNIQUE (code);

statement error
ALTER TABLE at9p ADD PRIMARY KEY (code);

statement ok
ALTER TABLE at9p ADD CONSTRAINT at9p_n_check CHECK (n > 0);

statement error
ALTER TABLE at9p ADD CONSTRAINT at9p_n_check CHECK (n > 0);

statement error
INSERT INTO at9p VALUES (3, 'c', -1);

statement error
ALTER TABLE at9p DROP CONSTRAINT nosuch;

statement ok
ALTER TABLE at9p DROP CONSTRAINT IF EXISTS nosuch;

statement error
ALTER TABLE at9p DROP CONSTRAINT at9p_pkey;

statement error
ALTER TABLE at9p DROP COLUMN id;

statement error
ALTER TABLE at9p RENAME COLUMN n TO code;

statement error
ALTER TABLE at9c ADD CONSTRAINT at9c_fk2 FOREIGN KEY (id) REFERENCES at9p (n);

statement ok
ALTER TABLE at9c DROP CONSTRAINT at9c_p_fkey;

statement ok
INSERT INTO at9c VALUES (2, 99);

statement error
ALTER TABLE at9c ADD CONSTRAINT at9c_p_fkey FOREIGN KEY (p) REFERENCES at9p;

statement ok
