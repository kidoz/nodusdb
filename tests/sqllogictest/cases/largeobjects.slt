# Large objects: the bytea API, descriptors, and the catalogs, PG 18.4.
statement ok
select lo_unlink(oid) from pg_largeobject_metadata where oid between 91000 and 91999;

query T
select lo_create(91001);
----
91001

query T
select lo_from_bytea(91002, 'hello world'::bytea);
----
91002

query T
select encode(lo_get(91002), 'hex');
----
68656c6c6f20776f726c64

query T
select encode(lo_get(91002, 6, 5), 'hex');
----
776f726c64

statement ok
select lo_put(91002, 6, 'there'::bytea);

query T
select encode(lo_get(91002), 'hex');
----
68656c6c6f207468657265

query T
select encode(lo_get(91002, 0, 1000), 'hex');
----
68656c6c6f207468657265

query T
select octet_length(lo_get(91002, 100, 5));
----
0

statement error
select lo_get(91002, 0, -1);

statement error
select lo_get(91002, -1, 5);

statement error
select lo_get(91002, 4398046511105, 5);

statement ok
select lo_put(91002, 8, ''::bytea);

