query T
select v, rank() over (order by v), dense_rank() over (order by v) from g1 order by v limit 4;
----
0	1	1
1	2	2
2	3	3
3	4	4

query T
select k, sum(v) over (partition by k order by v rows between unbounded preceding and current row) from g1 order by k, v limit 3;
----
1	7
2	14
3	21
