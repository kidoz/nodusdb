# Window plans: each window clause is a `WindowAgg` above the input, with
# the sort its ordering needs and the clause printed PostgreSQL's way —
# `wN AS (...)` numbered from the innermost out (a named `WINDOW w`
# prints its name), the default frame omitted, and a clause whose
# functions ignore the frame rewritten to `ROWS UNBOUNDED PRECEDING`.
# Clauses sharing an ordering stack in the order written (the first
# innermost); different orderings stack with the last written innermost,
# and `OVER ()` outermost. A query `ORDER BY` that a window already
# satisfies adds no Sort, one it only partly satisfies is an
# `Incremental Sort` over the prefix. A `UNION`'s dedup groups by the
# left input's columns. Plans and results from PostgreSQL 18.4.

statement ok
drop table if exists g1 cascade;

statement ok
drop table if exists g2 cascade;

statement ok
create table g1 (k int, v int);

statement ok
create table g2 (k int, w int);

statement ok
insert into g1 select g, (g * 7) % 90 from generate_series(1, 90) g;

statement ok
insert into g2 select g % 4, g from generate_series(1, 40) g;

statement ok
analyze g1;

statement ok
analyze g2;

query T
explain (costs off) select k, rank() over (order by v) from g1;
----
WindowAgg
  Window: w1 AS (ORDER BY v ROWS UNBOUNDED PRECEDING)
  ->  Sort
        Sort Key: v
        ->  Seq Scan on g1

query T
explain (costs off) select k, sum(v) over (partition by k order by v) from g1;
----
WindowAgg
  Window: w1 AS (PARTITION BY k ORDER BY v)
  ->  Sort
        Sort Key: k, v
        ->  Seq Scan on g1

query T
explain (costs off) select k, rank() over (order by v), sum(v) over () from g1;
----
WindowAgg
  Window: w2 AS ()
  ->  WindowAgg
        Window: w1 AS (ORDER BY v ROWS UNBOUNDED PRECEDING)
        ->  Sort
              Sort Key: v
              ->  Seq Scan on g1

query T
explain (costs off) select k, rank() over (order by v) from g1 order by v;
----
WindowAgg
  Window: w1 AS (ORDER BY v ROWS UNBOUNDED PRECEDING)
  ->  Sort
        Sort Key: v
        ->  Seq Scan on g1

query T
explain (costs off) select k, rank() over (partition by k) from g1 order by k;
----
WindowAgg
  Window: w1 AS (PARTITION BY k ROWS UNBOUNDED PRECEDING)
  ->  Sort
        Sort Key: k
        ->  Seq Scan on g1

query T
explain (costs off) select k, rank() over w from g1 window w as (order by v);
----
WindowAgg
  Window: w AS (ORDER BY v ROWS UNBOUNDED PRECEDING)
  ->  Sort
        Sort Key: v
        ->  Seq Scan on g1

query T
explain (costs off) select k, rank() over (order by count(*)) from g1 group by k;
----
WindowAgg
  Window: w1 AS (ORDER BY (count(*)) ROWS UNBOUNDED PRECEDING)
  ->  Sort
        Sort Key: (count(*))
        ->  HashAggregate
              Group Key: k
              ->  Seq Scan on g1

query T
explain (costs off) select k, rank() over (order by v) from g1 limit 3;
----
Limit
  ->  WindowAgg
        Window: w1 AS (ORDER BY v ROWS UNBOUNDED PRECEDING)
        ->  Sort
              Sort Key: v
              ->  Seq Scan on g1

query T
explain (costs off) select distinct rank() over (order by v) from g1;
----
HashAggregate
  Group Key: rank() OVER w1
  ->  WindowAgg
        Window: w1 AS (ORDER BY v ROWS UNBOUNDED PRECEDING)
        ->  Sort
              Sort Key: v
              ->  Seq Scan on g1

query T
explain (costs off) select k, sum(v) over (order by v rows between 1 preceding and current row) from g1;
----
WindowAgg
  Window: w1 AS (ORDER BY v ROWS BETWEEN '1'::bigint PRECEDING AND CURRENT ROW)
  ->  Sort
        Sort Key: v
        ->  Seq Scan on g1

query T
explain (costs off) select k, sum(v) over (order by v rows between 1 preceding and 2 following) from g1;
----
WindowAgg
  Window: w1 AS (ORDER BY v ROWS BETWEEN '1'::bigint PRECEDING AND '2'::bigint FOLLOWING)
  ->  Sort
        Sort Key: v
        ->  Seq Scan on g1

query T
explain (costs off) select k, sum(v) over (order by v range between unbounded preceding and unbounded following) from g1;
----
WindowAgg
  Window: w1 AS (ORDER BY v RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
  ->  Sort
        Sort Key: v
        ->  Seq Scan on g1

query T
explain (costs off) select k, rank() over (order by v), rank() over (order by k) from g1;
----
WindowAgg
  Window: w2 AS (ORDER BY v ROWS UNBOUNDED PRECEDING)
  ->  Sort
        Sort Key: v
        ->  WindowAgg
              Window: w1 AS (ORDER BY k ROWS UNBOUNDED PRECEDING)
              ->  Sort
                    Sort Key: k
                    ->  Seq Scan on g1

query T
explain (costs off) select k, first_value(v) over (order by v), last_value(v) over (order by k) from g1;
----
WindowAgg
  Window: w2 AS (ORDER BY v)
  ->  Sort
        Sort Key: v
        ->  WindowAgg
              Window: w1 AS (ORDER BY k)
              ->  Sort
                    Sort Key: k
                    ->  Seq Scan on g1

query T
explain (costs off) select k, rank() over (order by v) from g1 order by v, k;
----
Incremental Sort
  Sort Key: v, k
  Presorted Key: v
  ->  WindowAgg
        Window: w1 AS (ORDER BY v ROWS UNBOUNDED PRECEDING)
        ->  Sort
              Sort Key: v
              ->  Seq Scan on g1

query T
explain (costs off) select k from g1 order by rank() over (order by v);
----
Sort
  Sort Key: (rank() OVER w1)
  ->  WindowAgg
        Window: w1 AS (ORDER BY v ROWS UNBOUNDED PRECEDING)
        ->  Sort
              Sort Key: v
              ->  Seq Scan on g1

query T
explain (costs off) select k from g1 union select w from g2;
----
HashAggregate
  Group Key: g1.k
  ->  Append
        ->  Seq Scan on g1
        ->  Seq Scan on g2

query T
explain (costs off) select k, count(*) from g1 group by k having count(*) > 25;
----
HashAggregate
  Group Key: k
  Filter: (count(*) > 25)
  ->  Seq Scan on g1

# The rows the windows yield.
query T
select k, count(*), sum(cnt) over (order by k) from (select k, count(*) cnt from g1 group by k) t group by k, cnt order by k;
