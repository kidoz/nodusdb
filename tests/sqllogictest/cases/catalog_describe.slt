# What psql's \d and similar catalog introspection read: definitions of
# indexes, constraints, defaults, and views, type modifiers, not-null
# constraints, sequences, and object-identifier casts. Expected results
# come from PostgreSQL 18.
statement ok
CREATE TABLE cd1 (id SERIAL PRIMARY KEY, name TEXT NOT NULL DEFAULT 'x', score NUMERIC(10,2), code VARCHAR(12) UNIQUE, created DATE DEFAULT '2020-01-01', n INT DEFAULT 0 CHECK (n >= 0), g INT GENERATED ALWAYS AS (n * 2) STORED, ident BIGINT GENERATED BY DEFAULT AS IDENTITY, CHECK (n < 100));

statement ok
CREATE INDEX cd1_score ON cd1 (score);

statement ok
CREATE TABLE cd2 (a INT REFERENCES cd1(id), b TEXT);

statement ok
CREATE VIEW cd1v AS SELECT id, name FROM cd1 WHERE id > 0;

statement ok
CREATE SEQUENCE cd_seq START 5 INCREMENT 2;

query TTTTTTT
SELECT a.attname, pg_catalog.format_type(a.atttypid, a.atttypmod), a.attnotnull, a.atthasdef, a.attidentity, a.attgenerated, a.attstorage FROM pg_catalog.pg_attribute a WHERE a.attrelid = 'cd1'::regclass AND a.attnum > 0 ORDER BY a.attnum;
----
id	integer	t	t			p
name	text	t	t			x
score	numeric(10,2)	f	f			m
code	character varying(12)	f	f			x
created	date	f	t			p
n	integer	f	t			p
g	integer	f	t		s	p
ident	bigint	t	f	d		p

query TT
SELECT a.attname, pg_catalog.pg_get_expr(d.adbin, d.adrelid, true) FROM pg_catalog.pg_attrdef d JOIN pg_catalog.pg_attribute a ON a.attrelid = d.adrelid AND a.attnum = d.adnum WHERE d.adrelid = 'cd1'::regclass ORDER BY 1;
----
created	'2020-01-01'::date
g	n * 2
id	nextval('cd1_id_seq'::regclass)
n	0
name	'x'::text

query TTTTT
SELECT c2.relname, i.indisprimary, i.indisunique, pg_catalog.pg_get_indexdef(i.indexrelid, 0, true), pg_catalog.pg_get_indexdef(i.indexrelid) FROM pg_catalog.pg_class c2 JOIN pg_catalog.pg_index i ON i.indexrelid = c2.oid WHERE i.indrelid = 'cd1'::regclass ORDER BY 1;
----
cd1_code_key	f	t	CREATE UNIQUE INDEX cd1_code_key ON cd1 USING btree (code)	CREATE UNIQUE INDEX cd1_code_key ON public.cd1 USING btree (code)
cd1_pkey	t	t	CREATE UNIQUE INDEX cd1_pkey ON cd1 USING btree (id)	CREATE UNIQUE INDEX cd1_pkey ON public.cd1 USING btree (id)
cd1_score	f	f	CREATE INDEX cd1_score ON cd1 USING btree (score)	CREATE INDEX cd1_score ON public.cd1 USING btree (score)

query TTT
SELECT conname, contype, pg_catalog.pg_get_constraintdef(oid, true) FROM pg_catalog.pg_constraint WHERE conrelid = 'cd1'::regclass ORDER BY 1;
----
cd1_code_key	u	UNIQUE (code)
cd1_id_not_null	n	NOT NULL id
cd1_ident_not_null	n	NOT NULL ident
cd1_n_check	c	CHECK (n >= 0)
cd1_n_check1	c	CHECK (n < 100)
cd1_name_not_null	n	NOT NULL name
cd1_pkey	p	PRIMARY KEY (id)

query TTTT
SELECT conname, conrelid::regclass, confrelid::regclass, pg_catalog.pg_get_constraintdef(oid) FROM pg_catalog.pg_constraint WHERE conrelid = 'cd2'::regclass;
----
cd2_a_fkey	cd2	cd1	FOREIGN KEY (a) REFERENCES cd1(id)

query TT
SELECT c.conname, a.attname FROM pg_catalog.pg_constraint c JOIN pg_catalog.pg_attribute a ON (a.attrelid = c.conrelid AND a.attnum = c.conkey[1]) WHERE c.contype = 'n' AND c.conrelid = 'cd1'::regclass ORDER BY a.attnum;
----
cd1_id_not_null	id
cd1_name_not_null	name
cd1_ident_not_null	ident

query T
SELECT replace(pg_catalog.pg_get_viewdef('cd1v'::regclass, true), chr(10), '/');
----
 SELECT id,/    name/   FROM cd1/  WHERE id > 0;

query TTTTTTT
SELECT seqtypid::regtype, seqstart, seqincrement, seqmin, seqmax, seqcache, seqcycle FROM pg_catalog.pg_sequence WHERE seqrelid = 'cd_seq'::regclass;
----
bigint	5	2	1	9223372036854775807	1	f

query TT
SELECT d.deptype, a.attname FROM pg_catalog.pg_depend d JOIN pg_catalog.pg_attribute a ON a.attrelid = d.refobjid AND a.attnum = d.refobjsubid WHERE d.classid = 'pg_catalog.pg_class'::regclass AND d.refobjid = 'cd1'::regclass ORDER BY 2;
----
a	id
i	ident
a	score

query T
SELECT am.amname FROM pg_catalog.pg_class c JOIN pg_catalog.pg_am am ON am.oid = c.relam WHERE c.relname = 'cd1';
----
heap

query TTTTTT
SELECT 'cd1'::regclass, 'public.cd1'::regclass::text, 'cd1_pkey'::regclass, 'int4'::regtype, 'public'::regnamespace, 'pg_class'::regclass;
----
cd1	cd1	cd1_pkey	integer	public	pg_class

statement error
SELECT 'nosuch'::regclass;

query T
SELECT pg_catalog.pg_partition_ancestors('cd1');
----
