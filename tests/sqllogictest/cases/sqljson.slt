select json_objectagg(k value v) from (values (null,1)) t(k,v);;

statement error
select json_objectagg(array[1] value 1) from (values (1)) t(x);;

query T
select json_objectagg(k value v) from (values (1,2)) t(k,v);;
----
{ "1" : 2 }

query T rowsort
select json_objectagg(k value v) from (values ('a',1),('b',2)) t(k,v) group by k order by k;;
----
{ "a" : 1 }
{ "b" : 2 }

query T
select json_objectagg(k value '{"c": 3}' format json) from (values ('a')) t(k);;
----
{ "a" : {"c": 3} }

query T
select json_objectagg(k value v) from (values ('a',null)) t(k,v) where false;;
----
NULL

query T
select pg_typeof(json_objectagg(k value v)) from (values ('a',1)) t(k,v);;
----
json

query T
select json_objectagg(k value v)::text from (values ('a',1)) t(k,v);;
----
{ "a" : 1 }

query T
select json_objectagg(k value v) from (values ('a',1)) t(k,v) group by k;;
----
{ "a" : 1 }

query T
select json_arrayagg(x) from (values (1)) t(x) where 1=0 group by x;;
----

query T
select json_objectagg(k value v) from (values ('a',1)) t(k,v) where 1=0 group by k;;
----

query T
select json_array(returning jsonb);;
----
[]

query T
select json_object(returning text);;
----
{}

query T
select json_object(returning jsonb);;
----
{}

query T
select json_array(bytea '{"a":1}' format json encoding utf8);;
----
[{"a":1}]

statement error
select json_array('{"a":1}' format json encoding utf8);;

statement error
select json_array(null format json encoding utf8);;

query T
select json_object('a': bytea '{"b":1}' format json encoding utf8);;
----
{"a" : {"b":1}}

statement error
select json_array(absent on null);;

statement error
select json_object(null on null);;

query T
select json_object('c': 2, 'a': to_jsonb(1));;
----
{"a": 1, "c": 2}

query T
select json_arrayagg(to_jsonb(1)) from generate_series(1,1);;
----
[1]

query T
select json_objectagg(k value to_jsonb(1)) from (values ('a')) t(k);;
----
{"a": 1}

query T
select json_array(to_jsonb(1), json '{"d":4}');;
----
[1, {"d": 4}]

query T
select json_array(to_jsonb(1), json '{"d":4}' returning text);;
----
[1, {"d":4}]

query T
select json_object('a': to_jsonb(1) returning text);;
----
{"a" : 1}

query T
select json_object('a': to_jsonb(1) returning json);;
----
{"a" : 1}

statement error
select json_object('{"a":1}'::jsonb: 1);;
