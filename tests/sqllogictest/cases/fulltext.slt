SELECT websearch_to_tsquery('-x -y');
----
!'x' & !'y'

query T
SELECT websearch_to_tsquery('café naïve');
----
'café' & 'naïv'

query T
SELECT to_tsquery('english', 'runner & running <-> runs');
----
'runner' & 'run' <-> 'run'

query T
SELECT phraseto_tsquery('simple', 'a-café-x 42');
----
'a-café-x' <-> 'a' <-> 'café' <-> 'x' <-> '42'
