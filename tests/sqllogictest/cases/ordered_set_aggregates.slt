# Ordered-set and hypothetical-set aggregates (WITHIN GROUP).
statement ok
CREATE TABLE sales (id int PRIMARY KEY, region text, product text, qty int, price numeric(8,2), sold date);

statement ok
INSERT INTO sales VALUES (1,'east','apple',10,1.50,'2024-01-01'),(2,'east','pear',5,2.00,'2024-01-02'),(3,'west','apple',7,1.50,'2024-01-02'),(4,'west','pear',3,2.00,'2024-01-05'),(5,'west','apple',7,1.60,'2024-01-09'),(6,'north','plum',1,3.00,'2024-01-10'),(7,'east','apple',2,1.55,'2024-01-10');

query TTT
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY qty), percentile_disc(0.5) WITHIN GROUP (ORDER BY qty), mode() WITHIN GROUP (ORDER BY product) FROM sales;
----
5	5	apple

query TTT
SELECT region, percentile_cont(0.25) WITHIN GROUP (ORDER BY price), percentile_disc(0.75) WITHIN GROUP (ORDER BY price DESC) FROM sales GROUP BY region ORDER BY region;
----
east	1.525	1.50
north	3	3.00
west	1.55	1.50

query TT
SELECT percentile_cont(ARRAY[0.25, 0.5, 0.75]) WITHIN GROUP (ORDER BY qty), percentile_disc(ARRAY[0.1, 0.9]) WITHIN GROUP (ORDER BY qty) FROM sales;
----
{2.5,5,7}	{1,10}

query TT
SELECT percentile_disc(0.5) WITHIN GROUP (ORDER BY sold), percentile_cont(0.5) WITHIN GROUP (ORDER BY interval '1 day' * qty) FROM sales;
----
2024-01-05	5 days

query TTT
SELECT region, percentile_disc(0.5) WITHIN GROUP (ORDER BY product), mode() WITHIN GROUP (ORDER BY qty DESC) FROM sales GROUP BY region ORDER BY 1;
----
east	apple	10
north	plum	1
west	apple	7

query T
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY qty) FILTER (WHERE region = 'west') FROM sales;
----
7

query T
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY qty) FROM sales WHERE false;
----
NULL

query TTTT
SELECT rank(7) WITHIN GROUP (ORDER BY qty), dense_rank(7) WITHIN GROUP (ORDER BY qty), percent_rank(7) WITHIN GROUP (ORDER BY qty), cume_dist(7) WITHIN GROUP (ORDER BY qty) FROM sales;
----
5	5	0.5714285714285714	0.875

query TT
SELECT cume_dist(3) WITHIN GROUP (ORDER BY qty DESC), rank(3) WITHIN GROUP (ORDER BY qty DESC) FROM sales;
----
0.75	5

statement error
SELECT percentile_cont(1.5) WITHIN GROUP (ORDER BY qty) FROM sales;

statement error
SELECT percentile_cont(0.5) FROM sales;

statement error
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY sold) FROM sales;
