# ALTER SEQUENCE changes a sequence's options, and RESTART its position.
statement ok
CREATE SEQUENCE as9 START 10 INCREMENT 5;

query TT
SELECT nextval('as9'), nextval('as9');
----
10	15

statement ok
ALTER SEQUENCE as9 RESTART WITH 1;

query T
SELECT nextval('as9');
----
1

statement error
ALTER SEQUENCE as9 INCREMENT BY 2 MAXVALUE 6 CYCLE;

statement ok
ALTER SEQUENCE as9 INCREMENT BY 2 MAXVALUE 6 START 1 CYCLE;

query TTTT
SELECT nextval('as9'), nextval('as9'), nextval('as9'), nextval('as9');
----
3	5	1	3

statement ok
ALTER SEQUENCE as9 RESTART;

query T
SELECT nextval('as9');
----
1

statement ok
ALTER SEQUENCE as9 NO MAXVALUE NO CYCLE START WITH 100 INCREMENT 5;

query T
SELECT nextval('as9');
----
6

statement error
ALTER SEQUENCE as9 RESTART WITH 0;

statement error
ALTER SEQUENCE as9 MINVALUE 50;

statement ok
ALTER SEQUENCE as9 AS integer;

query TTTTTT
SELECT seqtypid::regtype, seqstart, seqincrement, seqmax, seqmin, seqcycle FROM pg_sequence WHERE seqrelid = 'as9'::regclass;
----
integer	100	5	2147483647	1	f

statement ok
ALTER SEQUENCE as9 RENAME TO as9r;

query T
SELECT nextval('as9r');
----
11

statement ok
ALTER SEQUENCE IF EXISTS as9nosuch RESTART;

statement error
ALTER SEQUENCE as9nosuch RESTART;

statement ok
CREATE TABLE as9t (id serial PRIMARY KEY, v int);

statement ok
ALTER SEQUENCE as9t_id_seq RESTART WITH 1000;

query T
INSERT INTO as9t (v) VALUES (1) RETURNING id;
----
1000

statement ok
ALTER SEQUENCE as9t_id_seq OWNED BY as9t.id;
