# Multiranges: literals, constructors, accessors, operators, aggregates,
# ordering, storage, and catalogs. Expected results come from PostgreSQL 18.
# --- multi
query T
SELECT '{}'::int4multirange;
----
{}

query T
SELECT '{[1,2)}'::int4multirange;
----
{[1,2)}

query T
SELECT '{[1,2),[3,4)}'::int4multirange;
----
{[1,2),[3,4)}

query T
SELECT '{[1,3), [5,7)}'::int4multirange;
----
{[1,3),[5,7)}

query T
SELECT '{[1,3),[2,4)}'::int4multirange;
----
{[1,4)}

query T
SELECT '{[3,4),[1,2)}'::int4multirange;
----
{[1,2),[3,4)}

query T
SELECT '{(,2),[3,)}'::int4multirange;
----
{(,2),[3,)}

query T
SELECT '{[1,2),[2,3)}'::int4multirange;
----
{[1,3)}

query TT
SELECT '{}'::nummultirange, '{[1.5,2.5)}'::nummultirange;
----
{}	{[1.5,2.5)}

query T
SELECT '{[2020-01-01,2020-01-03)}'::datemultirange;
----
{[2020-01-01,2020-01-03)}

query T
SELECT '{["2020-01-01 00:00","2020-01-02 00:00")}'::tsmultirange;
----
{["2020-01-01 00:00:00","2020-01-02 00:00:00")}

query T
SELECT '{["2020-01-01 00:00+00","2020-01-02 00:00+00")}'::tstzmultirange;
----
{["2020-01-01 00:00:00+00","2020-01-02 00:00:00+00")}

