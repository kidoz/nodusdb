# --- multi4
query TTTTTTTT
SELECT typname, oid, typtype, typcategory, typlen, typbyval, typalign, typstorage FROM pg_type WHERE typname IN ('int4multirange','int8multirange','nummultirange','datemultirange','tsmultirange','tstzmultirange') ORDER BY oid;
----
int4multirange	4451	m	R	-1	f	i	x
nummultirange	4532	m	R	-1	f	i	x
tsmultirange	4533	m	R	-1	f	d	x
tstzmultirange	4534	m	R	-1	f	d	x
datemultirange	4535	m	R	-1	f	i	x
int8multirange	4536	m	R	-1	f	d	x

query TTTTTT
SELECT format_type(4451, NULL), format_type(4532, NULL), format_type(4533, NULL), format_type(4534, NULL), format_type(4535, NULL), format_type(4536, NULL);
----
int4multirange	nummultirange	tsmultirange	tstzmultirange	datemultirange	int8multirange

query TT
SELECT rngtypid::regtype, rngmultitypid::regtype FROM pg_range ORDER BY rngtypid;
----
int4range	int4multirange
numrange	nummultirange
tsrange	tsmultirange
tstzrange	tstzmultirange
daterange	datemultirange
int8range	int8multirange

query TTT
SELECT '_int4multirange'::regtype::oid, 'int4multirange'::regtype::oid, 'datemultirange'::regtype::oid;
----
6150	4451	4535

query T
SELECT oid::regtype FROM pg_type WHERE typname IN ('int4multirange', '_int4multirange', 'tstzmultirange') ORDER BY oid;
----
int4multirange
tstzmultirange
int4multirange[]

query T
SELECT pg_typeof('{[1,2)}'::int4multirange);
----
int4multirange

query T
SELECT pg_typeof(int4multirange(int4range(1,2)));
----
int4multirange

statement ok
CREATE TABLE mt (id int PRIMARY KEY, m int4multirange, v nummultirange);

query T
SELECT * FROM mt ORDER BY id;
----

query T
SELECT m FROM mt ORDER BY m;
----

query T rowsort
SELECT m FROM mt WHERE m @> 1;
----

query T
SELECT count(*) FROM mt GROUP BY m ORDER BY 1;
----

query T rowsort
SELECT count(*) FROM mt GROUP BY m;
----

query T
SELECT DISTINCT m FROM mt ORDER BY m;
----

query TTT
SELECT column_name, data_type, udt_name FROM information_schema.columns WHERE table_name = 'mt' ORDER BY ordinal_position;
----
id	integer	int4
m	int4multirange	int4multirange
v	nummultirange	nummultirange

statement ok
CREATE TABLE mck (m int4multirange CHECK (m @> 2));

statement ok
INSERT INTO mck VALUES ('{[1,3)}');

statement error
INSERT INTO mck VALUES ('{[5,6)}');

query T
SELECT m FROM mck;
----
{[1,3)}

