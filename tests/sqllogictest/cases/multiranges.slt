----
5

query TT
SELECT lower_inc('{[1,2),[3,5)}'::int4multirange), upper_inc('{[1,2),[3,5)}'::int4multirange);
----
t	f

query TT
SELECT lower_inc('{(1,2],(3,5]}'::int4multirange), upper_inc('{(1,2],(3,5]}'::int4multirange);
----
t	f

query TT
SELECT lower_inf('{(,2)}'::int4multirange), upper_inf('{(,2)}'::int4multirange);
----
t	f

query TT
SELECT lower('{}'::int4multirange), upper('{}'::int4multirange);
----
NULL	NULL

query TT
SELECT lower_inc('{}'::int4multirange), upper_inc('{}'::int4multirange);
----
f	f

query TT
SELECT lower_inf('{}'::int4multirange), upper_inf('{}'::int4multirange);
----
f	f

query TT
SELECT isempty('{}'::int4multirange), isempty('{[1,2)}'::int4multirange);
----
t	f

