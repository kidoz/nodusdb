# --- multi9
query T
SELECT unnest('{[1,2),[3,5)}'::int4multirange);
----
[1,2)
[3,5)

query TT
SELECT to_json('{[1,2)}'::int4multirange), jsonb_build_array('{[1,2)}'::int4multirange);
----
"{[1,2)}"	["{[1,2)}"]

query T
SELECT json_agg(m) FROM (SELECT '{[1,2)}'::int4multirange AS m) t;
----
["{[1,2)}"]

query T
SELECT string_agg(m::text, ',') FROM (SELECT '{[1,2)}'::int4multirange AS m UNION ALL SELECT '{}') t;
----
{[1,2)},{}

query T
SELECT range_agg(r) @> 2 FROM (VALUES ('[1,3)'::int4range)) t(r);
----
t

query T
SELECT range_agg(r) FILTER (WHERE r @> 5) FROM (VALUES ('[1,3)'::int4range), ('[4,6)')) t(r);
----
{[4,6)}

query T
SELECT m FROM (VALUES ('{[1,2)}'::int4multirange), (NULL)) t(m) ORDER BY m DESC NULLS LAST;
----
{[1,2)}
NULL

query T
SELECT pg_typeof(u) FROM unnest('{[1,2)}'::int4multirange) u;
----
int4range

statement ok
CREATE TABLE md (m int4multirange DEFAULT '{[1,2)}');

statement ok
INSERT INTO md DEFAULT VALUES;

query T rowsort
SELECT * FROM md;
----
{[1,2)}

statement ok
ALTER TABLE md ADD COLUMN m2 int8multirange;

statement ok
INSERT INTO md VALUES ('{[1,2)}', '{[3,4)}');

query TT
SELECT * FROM md ORDER BY m;
----
{[1,2)}	NULL
{[1,2)}	{[3,4)}

query T rowsort
SELECT m2 FROM md WHERE m2 IS NOT NULL;
----
{[3,4)}

query T
SELECT '{[1,2)}'::int4multirange = '{[1,3)}'::int4multirange;
----
f
