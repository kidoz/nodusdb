# Statistical and bitwise aggregates: exact numeric spread, pairs, bit_xor, any_value.
statement ok
CREATE TABLE sales (id int PRIMARY KEY, region text, product text, qty int, price numeric(8,2), sold date);

statement ok
INSERT INTO sales VALUES (1,'east','apple',10,1.50,'2024-01-01'),(2,'east','pear',5,2.00,'2024-01-02'),(3,'west','apple',7,1.50,'2024-01-02'),(4,'west','pear',3,2.00,'2024-01-05'),(5,'west','apple',7,1.60,'2024-01-09'),(6,'north','plum',1,3.00,'2024-01-10'),(7,'east','apple',2,1.55,'2024-01-10');

query TTTT
SELECT stddev(qty), stddev_samp(qty), var_pop(qty), variance(price) FROM sales;
----
3.2145502536643183	3.2145502536643183	8.8571428571428571	0.29321428571428571429

query TTTTT
SELECT stddev_pop(qty), var_samp(qty), stddev(price), stddev(qty::float8), variance(qty::float8) FROM sales;
----
2.9760952365713798	10.3333333333333333	0.54149264603897042610	3.2145502536643185	10.333333333333334

query TT
SELECT stddev(qty), var_pop(qty) FROM sales WHERE id = 1;
----
NULL	0

query TTT
SELECT round(corr(qty, price)::numeric, 10), round(covar_pop(qty, price)::numeric, 10), round(covar_samp(qty, price)::numeric, 10) FROM sales;
----
-0.6654581859	-0.9928571429	-1.1583333333

query TTTT
SELECT round(regr_slope(price, qty)::numeric, 10), round(regr_intercept(price, qty)::numeric, 10), regr_count(price, qty), round(regr_r2(price, qty)::numeric, 10) FROM sales;
----
-0.1120967742	2.4390552995	7	0.4428345972

query TTTTT
SELECT regr_avgx(price, qty), regr_avgy(price, qty), round(regr_sxx(price, qty)::numeric, 8), round(regr_syy(price, qty)::numeric, 8), round(regr_sxy(price, qty)::numeric, 8) FROM sales;
----
5	1.8785714285714286	62.00000000	1.75928571	-6.95000000

query T
SELECT corr(qty, price) FROM sales WHERE id = 1;
----
NULL

query TTTTT
SELECT bit_and(qty), bit_or(qty), bit_xor(qty), bool_and(qty > 0), every(qty > 1) FROM sales;
----
0	15	15	t	f

query TTTT
SELECT min(sold), max(product), any_value(region) IS NOT NULL, bit_xor(id) FROM sales;
----
2024-01-01	plum	t	0
