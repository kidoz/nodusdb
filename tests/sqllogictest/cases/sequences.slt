# Sequences, serial and identity columns, and generated columns.
# Expected results come from PostgreSQL 18.
statement ok
CREATE SEQUENCE sq INCREMENT 2 START 5;

query TTTT
SELECT nextval('sq'), nextval('sq'), currval('sq'), lastval();
----
5	7	7	7

query TT
SELECT setval('sq', 100), nextval('sq');
----
100	102

query TTT
SELECT setval('sq', 50, false), nextval('sq'), nextval('sq');
----
50	50	52

query TT
SELECT last_value, is_called FROM sq;
----
52	t

statement ok
CREATE SEQUENCE sd INCREMENT BY -1 MINVALUE -3 MAXVALUE -1 NO CYCLE;

query TTT
SELECT nextval('sd'), nextval('sd'), nextval('sd');
----
-1	-2	-3

statement error
SELECT nextval('sd');

statement ok
CREATE SEQUENCE sc MINVALUE 1 MAXVALUE 2 CYCLE;

query TTT
SELECT nextval('sc'), nextval('sc'), nextval('sc');
----
1	2	1

statement ok
CREATE SEQUENCE public.qualified START WITH 10;

query TT
SELECT nextval('public.qualified'), nextval('QUALIFIED');
----
10	11

statement ok
CREATE SEQUENCE dump_style AS integer START WITH 3 INCREMENT BY 3 NO MINVALUE NO MAXVALUE CACHE 1;

query TT
SELECT nextval('dump_style'), nextval('dump_style');
----
3	6

statement error
SELECT currval('nosuch');

statement error
SELECT nextval('nosuch');

statement error
CREATE SEQUENCE sq;

statement ok
CREATE SEQUENCE IF NOT EXISTS sq;

statement error
CREATE SEQUENCE bad INCREMENT 0;

statement error
CREATE SEQUENCE bad2 MINVALUE 5 MAXVALUE 1;

statement error
SELECT setval('sc', 99);

statement ok
CREATE TABLE sr (id SERIAL PRIMARY KEY, v TEXT);

statement ok
INSERT INTO sr (v) VALUES ('a'), ('b');

query T
INSERT INTO sr (v) VALUES ('c') RETURNING id;
----
3

query TT
INSERT INTO sr VALUES (DEFAULT, 'd') RETURNING id, v;
----
4	d

statement ok
INSERT INTO sr (id, v) VALUES (100, 'e');

query TT
SELECT * FROM sr ORDER BY id;
----
1	a
2	b
3	c
4	d
100	e

query TT
SELECT pg_get_serial_sequence('sr', 'id'), nextval('sr_id_seq');
----
public.sr_id_seq	5

statement ok
CREATE TABLE bs (id BIGSERIAL, n SMALLSERIAL, v TEXT);

statement ok
INSERT INTO bs (v) VALUES ('x'), ('y');

query TTT
SELECT * FROM bs ORDER BY id;
----
1	1	x
2	2	y

statement ok
CREATE TABLE idt (id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, v TEXT);

statement ok
INSERT INTO idt (v) VALUES ('a'), ('b');

query TT
SELECT * FROM idt ORDER BY id;
----
1	a
2	b

statement error
INSERT INTO idt (id, v) VALUES (10, 'x');

statement error
UPDATE idt SET id = 5 WHERE v = 'a';

statement ok
UPDATE idt SET v = 'z', id = DEFAULT WHERE v = 'a';

query TT
SELECT * FROM idt ORDER BY id;
----
2	b
3	z

statement ok
CREATE TABLE idd (id BIGINT GENERATED BY DEFAULT AS IDENTITY (START WITH 10 INCREMENT BY 5) PRIMARY KEY, v TEXT);

statement ok
INSERT INTO idd (v) VALUES ('a');

statement ok
INSERT INTO idd (id, v) VALUES (1, 'b');

statement ok
INSERT INTO idd (v) VALUES ('c');

query TT
SELECT * FROM idd ORDER BY id;
----
1	b
10	a
15	c

query T
SELECT pg_get_serial_sequence('idd', 'id');
----
public.idd_id_seq

statement ok
CREATE TABLE gen (a INT, b INT GENERATED ALWAYS AS (a * 2) STORED, c TEXT GENERATED ALWAYS AS ('v' || a) STORED);

statement ok
INSERT INTO gen (a) VALUES (1), (5), (NULL);

query TTT
SELECT * FROM gen ORDER BY a;
----
1	2	v1
5	10	v5
NULL	NULL	NULL

statement ok
UPDATE gen SET a = 10 WHERE a = 1;

query TTT
SELECT * FROM gen ORDER BY a;
----
5	10	v5
10	20	v10
NULL	NULL	NULL

statement error
INSERT INTO gen (a, b) VALUES (1, 2);

statement error
UPDATE gen SET b = 3;

statement ok
INSERT INTO gen VALUES (7, DEFAULT, DEFAULT);

query TTT
SELECT * FROM gen WHERE a = 7;
----
7	14	v7

query TT
SELECT relname, relkind FROM pg_class WHERE relname IN ('sq', 'sr', 'sr_id_seq', 'idt_id_seq') ORDER BY 1;
----
idt_id_seq	S
sq	S
sr	r
sr_id_seq	S

