# jsonpath: the literal type, its canonical form, the @?/@@ operators, and
# the jsonb_path_* functions. Expected results come from PostgreSQL 18.
statement ok
CREATE TABLE jp_t (id INT PRIMARY KEY, doc JSONB, p JSONPATH);

statement ok
INSERT INTO jp_t VALUES (1, '{"a":[1,2,3],"b":{"c":4}}', '$.a[*]'), (2, '{"a":[4]}', '$.a[*] ? (@ > 10)'), (3, '{"b":1}', NULL);

query T
SELECT '$'::jsonpath;
----
$

query T
SELECT '$.a.b'::jsonpath;
----
$."a"."b"

query T
SELECT '$."a b"'::jsonpath;
----
$."a b"

