the table	a view	a seq

query TTTT
SELECT col_description('cm8'::regclass, 2), col_description('cm8'::regclass, 5), col_description('cm8'::regclass, 0), col_description('cm8v'::regclass, 1);
----
num	NULL	the table	vx

query T
SELECT obj_description('cm8'::regclass, 'pg_namespace');
