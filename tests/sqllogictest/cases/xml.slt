query TTTTTTTTTTTTT
select oid, typname, typlen, typbyval, typtype, typcategory, typdelim, typcollation, typalign, typstorage, typtypmod, typndims, typbasetype from pg_type where oid in (142,143);
----
142	xml	-1	f	b	U	,	0	i	x	-1	0	0
143	_xml	-1	f	b	A	,	0	i	x	-1	0	0

query T
select format_type(142, null);
----
xml

query T
select format_type(143, null);
----
xml[]

query T
select pg_typeof('<a/>'::xml is document);
----
boolean

# The SQL/XML constructors: XMLELEMENT, XMLATTRIBUTES, XMLFOREST, XMLPI, XMLROOT.
query T
select xmlelement(name foo);
----
<foo/>

query T
select xmlelement(name foo, 'bar'::text);
----
<foo>bar</foo>

query T
select xmlelement(name foo, 1);
----
<foo>1</foo>

query T
select xmlelement(name foo, 1, true, 2.5);
----
<foo>1true2.5</foo>

query T
select xmlelement(name foo, null::text);
----
<foo/>

query T
select xmlelement(name foo, '<b/>'::xml);
----
<foo><b/></foo>

query T
select xmlelement(name foo, '<b/>'::text);
----
<foo>&lt;b/&gt;</foo>

query T
select xmlelement(name foo, '<b/>');
----
<foo>&lt;b/&gt;</foo>

query T
select xmlelement(name foo, '<b/>'::xml, '<c/>'::text);
----
<foo><b/>&lt;c/&gt;</foo>

query T
select xmlelement(name foo, array[1,2,null,3]);
----
<foo><element>1</element><element>2</element><element>3</element></foo>

query T
select xmlelement(name foo, xmlattributes(1 as a, 'x<y>' as b));
----
<foo a="1" b="x&lt;y&gt;"/>

query T
select xmlelement(name foo, xmlattributes('&' as a), 'bar');
----
<foo a="&amp;">bar</foo>

query T
select xmlelement(name foo, xmlattributes(true as x, null as y));
----
<foo x="true"/>

query T
select xmlelement(name foo, xmlattributes('a"b' as x));
----
<foo x="a&quot;b"/>

query T
select xmlelement(name foo, E'a\rb');
----
<foo>a&#x0d;b</foo>

query T
select xmlelement(name "Foo bar", 'x');
----
<Foo_x0020_bar>x</Foo_x0020_bar>

query T
select xmlelement(name "xmlfoo", 'x');
----
<xmlfoo>x</xmlfoo>

query T
select xmlelement(name foo, xmlattributes(1 as "a b"));
----
<foo a_x0020_b="1"/>

statement error
select xmlelement(name foo, xmlattributes(1));

statement error
select xmlelement(name foo, xmlattributes(1 as a, 2 as a));

query T
select xmlforest('<b/>'::xml as a, 'x<y' as b);
----
<a><b/></a><b>x&lt;y</b>

query T
select xmlforest(1 as a, null::int as b);
----
<a>1</a>

query T
select xmlforest(null::int as a);
----
NULL

query T
select xmlforest('x' as a);
----
<a>x</a>

query T
select xmlpi(name foo, 'bar');
----
<?foo bar?>

query T
select xmlpi(name foo);
----
<?foo?>

query T
select xmlpi(name "a b", 'x');
----
<?a_x0020_b x?>

query T
select xmlpi(name foo, null::text);
----
NULL

statement error
select xmlpi(name xml);

statement error
select xmlpi(name foo, '<?>');

query T
select xmlroot('<a/>'::xml, version '1.1');
----
<?xml version="1.1"?><a/>

query T
select xmlroot('<a/>'::xml, version no value);
----
<a/>

query T
select xmlroot('<a/>'::xml, version '1.0', standalone no);
----
<?xml version="1.0" standalone="no"?><a/>

query T
select xmlroot('<a/>'::xml, version '1.1', standalone yes);
----
<?xml version="1.1" standalone="yes"?><a/>

query T
select xmlroot('<?xml version="1.1"?><a/>'::xml, version no value, standalone no value);
----
<a/>

query T
select xmlroot('<a/>'::xml, version '', standalone no value);
----
<?xml version=""?><a/>

query T
select xmlroot('<?xml version="1.1"?><a/>'::xml, version '1.0', standalone no value);
----
<a/>

statement ok
create table xml_data(x xml);

statement ok
insert into xml_data values ('<b/>'), ('<a/>'), (null);

query T
select xmlagg(x) from xml_data;
----
<b/><a/>

query T
select xmlagg(null::xml);
----
NULL

query T
select xmlagg('<a/>');
----
<a/>

statement error
select xmlagg(1);

statement error
select xmlagg(x order by x) from xml_data;

statement error
select xmlserialize(content '<a/>'::xml as varchar(3));

query T
select pg_typeof(xmlelement(name foo, 'x'));
----
xml

query T
select pg_typeof(xmlforest('x' as a));
----
xml

query T
select pg_typeof(xmlpi(name foo));
----
xml
