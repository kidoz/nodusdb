# The xml type: values, well-formedness, and the SQL/XML functions.
query T
select '<a/>'::xml;
----
<a/>

query T
select 'a'::xml;
----
a

query T
select '<a/>text'::xml;
----
<a/>text

query T
select pg_typeof('<a/>'::xml);
----
xml

query T
select '<a/>'::xml::text;
----
<a/>

query T
select '<?xml version="1.0" encoding="UTF-8"?><a/>'::xml;
----
<a/>

