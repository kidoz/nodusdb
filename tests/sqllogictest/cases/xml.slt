----
<?xml version="1.1"?><a/>

query T
select '<?xml version="1.0" standalone="yes"?><a/>'::xml;
----
<?xml version="1.0" standalone="yes"?><a/>

query T
select E'\n<a/>'::xml;
----
<a/>

