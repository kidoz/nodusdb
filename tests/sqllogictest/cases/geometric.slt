# --- geo5
query TTTTTTTTT
SELECT typname, oid, typarray, typlen, typbyval, typalign, typstorage, typcategory, typdelim FROM pg_type WHERE typname IN ('point','lseg','line','box','path','polygon','circle') ORDER BY oid;
----
point	600	1017	16	f	d	p	G	,
lseg	601	1018	32	f	d	p	G	,
path	602	1019	-1	f	d	x	G	,
box	603	1020	32	f	d	p	G	;
polygon	604	1027	-1	f	d	x	G	,
line	628	629	24	f	d	p	G	,
circle	718	719	24	f	d	p	G	,

query TTTT
SELECT format_type(600, NULL), format_type(628, NULL), format_type(718, NULL), format_type(1017, NULL);
----
point	line	circle	point[]

query TTT
SELECT 'point'::regtype::oid, '_box'::regtype::oid, 'circle'::regtype::oid;
----
600	1020	718

query T
SELECT ARRAY['(1,2)'::point, '(3,4)'::point];
----
{"(1,2)","(3,4)"}

query TT
SELECT pg_typeof(point(1,2)), pg_typeof('(1,2)'::point::text);
----
point	text

statement ok
CREATE TABLE gt (id int PRIMARY KEY, p point, b box, c circle, pa path);

statement ok
INSERT INTO gt VALUES (1, '(1,2)', '((0,0),(2,2))', '<(1,1),1>', '[(0,0),(1,1)]');

statement ok
INSERT INTO gt VALUES (2, '(3,4)', '((5,5),(6,6))', '<(0,0),3>', '[(2,2),(3,3)]');

statement ok
INSERT INTO gt VALUES (3, NULL, NULL, NULL, NULL);

query TTTTT
SELECT * FROM gt ORDER BY id;
----
1	(1,2)	(2,2),(0,0)	<(1,1),1>	[(0,0),(1,1)]
2	(3,4)	(6,6),(5,5)	<(0,0),3>	[(2,2),(3,3)]
3	NULL	NULL	NULL	NULL

query T
SELECT id FROM gt WHERE b @> point(1,1) ORDER BY id;
----
1

query T rowsort
SELECT count(*) FROM gt WHERE b && '((1,1),(3,3))'::box;
----
1

statement error
SELECT p FROM gt ORDER BY p;

statement error
SELECT b FROM gt ORDER BY b;

statement error
SELECT c FROM gt ORDER BY c;

statement error
SELECT DISTINCT c FROM gt ORDER BY c;

statement error
SELECT count(*) FROM gt GROUP BY c ORDER BY 1;

query TTT
SELECT column_name, data_type, udt_name FROM information_schema.columns WHERE table_name = 'gt' ORDER BY ordinal_position;
----
id	integer	int4
p	point	point
b	box	box
c	circle	circle
pa	path	path

statement error
CREATE INDEX gt_b_idx ON gt (b);

query T rowsort
SELECT count(*) FROM gt WHERE b = '((0,0),(2,2))'::box;
----
1

