query TTT
SELECT id, string_agg(product, ',') OVER (ORDER BY id ROWS 1 PRECEDING), count(*) FILTER (WHERE qty > 4) OVER (ORDER BY id) FROM sales ORDER BY id;
----
1	apple	1
2	apple,pear	2
3	pear,apple	3
4	apple,pear	3
5	pear,apple	4
6	apple,plum	4
7	plum,apple	4

query TT
SELECT DISTINCT region, count(*) OVER (PARTITION BY region) FROM sales ORDER BY 1;
----
east	3
north	1
west	3

query TTT
SELECT * FROM (SELECT id, region, row_number() OVER (PARTITION BY region ORDER BY qty DESC, id) AS rn FROM sales) t WHERE rn = 1 ORDER BY region;
----
1	east	1
6	north	1
3	west	1

