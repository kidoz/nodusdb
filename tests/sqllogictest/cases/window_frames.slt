# Window functions over expressions, named windows, and every kind of frame.
statement ok
CREATE TABLE sales (id int PRIMARY KEY, region text, product text, qty int, price numeric(8,2), sold date);

statement ok
INSERT INTO sales VALUES (1,'east','apple',10,1.50,'2024-01-01'),(2,'east','pear',5,2.00,'2024-01-02'),(3,'west','apple',7,1.50,'2024-01-02'),(4,'west','pear',3,2.00,'2024-01-05'),(5,'west','apple',7,1.60,'2024-01-09'),(6,'north','plum',1,3.00,'2024-01-10'),(7,'east','apple',2,1.55,'2024-01-10');

query TTTT
SELECT id, sum(qty * 2) OVER (), lag(qty * 2) OVER (ORDER BY id), 1 + sum(qty) OVER (ORDER BY id) FROM sales ORDER BY id;
----
1	70	NULL	11
2	70	20	16
3	70	10	23
4	70	14	26
5	70	6	33
6	70	14	34
7	70	2	36

query TT
SELECT id, sum(qty) OVER (PARTITION BY upper(region) ORDER BY qty + 0, id) FROM sales ORDER BY id;
----
1	17
2	7
3	10
4	3
5	17
6	1
7	2

query TTT
SELECT id, sum(qty) OVER (ORDER BY id NULLS FIRST), row_number() OVER (ORDER BY qty DESC, id) AS rn FROM sales ORDER BY rn;
----
1	10	1
3	22	2
5	32	3
2	15	4
4	25	5
7	35	6
6	33	7

query T
SELECT id FROM sales ORDER BY row_number() OVER (ORDER BY qty, id) DESC LIMIT 3;
----
1
5
3

query TTTT
SELECT region, sum(qty), rank() OVER (ORDER BY region), row_number() OVER (ORDER BY count(*) DESC, region) FROM sales GROUP BY region ORDER BY 1;
----
east	17	1	1
north	1	2	3
west	17	3	2

query TTTT
SELECT region, sum(qty), sum(sum(qty)) OVER () AS total, round(100.0 * sum(qty) / sum(sum(qty)) OVER (), 1) AS pct FROM sales GROUP BY region ORDER BY region;
----
east	17	35	48.6
north	1	35	2.9
west	17	35	48.6

query TTTT
SELECT region, product, sum(qty), rank() OVER (PARTITION BY region ORDER BY sum(qty) DESC) FROM sales GROUP BY region, product ORDER BY 1, 4, 2;
----
east	apple	12	1
east	pear	5	2
north	plum	1	1
west	apple	14	1
west	pear	3	2

query TTTT
SELECT id, qty, sum(qty) OVER w, avg(qty) OVER w FROM sales WINDOW w AS (PARTITION BY region ORDER BY id) ORDER BY id;
----
1	10	10	10.0000000000000000
2	5	15	7.5000000000000000
3	7	7	7.0000000000000000
4	3	10	5.0000000000000000
5	7	17	5.6666666666666667
6	1	1	1.00000000000000000000
7	2	17	5.6666666666666667

query TTT
SELECT id, sum(qty) OVER w1, sum(qty) OVER w2 FROM sales WINDOW w1 AS (ORDER BY id), w2 AS (w1 ROWS 1 PRECEDING) ORDER BY id;
----
1	10	10
2	15	15
3	22	12
4	25	10
5	32	10
6	33	8
7	35	3

query TT
SELECT id, sum(qty) OVER (w ORDER BY id) FROM sales WINDOW w AS (PARTITION BY region) ORDER BY id;
----
1	10
2	15
3	7
4	10
5	17
6	1
7	17

statement error
SELECT id, sum(qty) OVER nosuch FROM sales;

query TTTT
SELECT id, qty, cume_dist() OVER (ORDER BY qty), percent_rank() OVER (ORDER BY qty) FROM sales ORDER BY id;
----
