2	5	0.5714285714285714	0.5
3	7	0.8571428571428571	0.6666666666666666
4	3	0.42857142857142855	0.3333333333333333
5	7	0.8571428571428571	0.6666666666666666
6	1	0.14285714285714285	0
7	2	0.2857142857142857	0.16666666666666666

query TTTT
SELECT id, nth_value(qty, 2) OVER (ORDER BY id), nth_value(qty, 2) OVER (ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING), last_value(qty) OVER (ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM sales ORDER BY id;
----
1	NULL	5	2
2	5	5	2
3	5	5	2
4	5	5	2
5	5	5	2
6	5	5	2
7	5	5	2

query TTTT
SELECT id, lead(qty, 2, 0) OVER (ORDER BY id), lag(qty, 1, -1) OVER (ORDER BY id), ntile(3) OVER (ORDER BY id) FROM sales ORDER BY id;
----
1	7	-1	1
2	3	10	1
3	7	5	1
4	1	7	2
5	2	3	2
6	0	7	3
7	0	1	3

query TT
SELECT id, sum(qty) OVER (ORDER BY qty RANGE BETWEEN 2 PRECEDING AND 2 FOLLOWING) FROM sales ORDER BY id;
